import GU.Bundle.DefectClass

/-!
# A cover with a nonzero ℤ/2 Čech class

The defect class (`DefectClass.lean`) lives in the full ℤ/2 Čech cochains of a fixed cover, with
continuous (locally constant) coefficients. Here: a cover on which that cohomology is nonzero, so
`IsCobdy` is not automatic for cocycles.

* `B4`: the nonempty faces of the boundary of a tetrahedron (subsets of `{0,1,2,3}` with at most three
  elements), with the topology generated by the open stars `Vs i = {S | i ∈ S}`. Every open set
  containing the face `{i, j}` contains `Vs i ∩ Vs j` (`subset_of_mem_open`), so continuous ℤ/2-valued
  functions on a double overlap are constant (`eq_on_overlap`). Triple overlaps of distinct indices are
  single triangles, quadruple ones are empty: the nerve is the boundary of a tetrahedron (informal:
  a model of the 2-sphere).
* `c0`: `1` on the triples whose index set is `{0,1,2}`, else `0`. It is a Čech 2-cocycle (`c0_cocycle`)
  and **not a coboundary** (`c0_not_cobdy`).

Scope: this is a cocycle, not the defect of a frame system. On this space continuous maps from an
open set to a Hausdorff group are locally constant, and the space is simply connected (informal), so
every frame system over it is flat and trivial, and its defect is always a coboundary. A nonzero
*defect* needs a base that is not simply connected (a flat bundle over the real projective plane with a
holonomy that does not lift to `Spin` would do) or a clutching construction over the 2-sphere. What is
missing is not Čech machinery but a construction of a non-trivial `FrameSys` from transition data
(bundle from a cocycle); it is not built here.
-/

namespace GU.Library

open TopologicalSpace Topology

noncomputable section

/-- Nonempty faces of the boundary of the tetrahedron. -/
def B4 : Type := {S : Finset (Fin 4) // S.Nonempty ∧ S.card ≤ 3}

/-- The open star of the vertex `i`. -/
def Vs (i : Fin 4) : Set B4 := {S | i ∈ S.1}

instance : TopologicalSpace B4 := generateFrom (Set.range Vs)

lemma isOpen_Vs (i : Fin 4) : IsOpen (Vs i) := isOpen_generateFrom_of_mem ⟨i, rfl⟩

/-- The face `{i, j}`. -/
def edgeF (i j : Fin 4) : B4 := ⟨{i, j}, ⟨i, by simp⟩, (Finset.card_le_two).trans (by norm_num)⟩

lemma edgeF_mem (i j : Fin 4) : edgeF i j ∈ Vs i ∩ Vs j :=
  ⟨show i ∈ ({i, j} : Finset (Fin 4)) by simp, show j ∈ ({i, j} : Finset (Fin 4)) by simp⟩

/-- **Every open set containing the face `{i, j}` contains `Vs i ∩ Vs j`.** -/
lemma subset_of_mem_open {U : Set B4} (hU : IsOpen U) {i j : Fin 4} (h : edgeF i j ∈ U) :
    Vs i ∩ Vs j ⊆ U := by
  induction hU with
  | basic s hs =>
    obtain ⟨k, rfl⟩ := hs
    intro S hS
    have hk : k ∈ ({i, j} : Finset (Fin 4)) := h
    simp only [Finset.mem_insert, Finset.mem_singleton] at hk
    rcases hk with rfl | rfl
    · exact hS.1
    · exact hS.2
  | univ => exact fun _ _ => trivial
  | inter s t _ _ hs ht => exact fun S hS => ⟨hs h.1 hS, ht h.2 hS⟩
  | sUnion F _ hF =>
    obtain ⟨s, hsF, hs⟩ := h
    exact fun S hS => ⟨s, hsF, hF s hsF hs hS⟩

/-- **Continuous ℤ/2-valued functions on a double overlap are constant.** -/
lemma eq_on_overlap {i j : Fin 4} {f : B4 → ZMod 2} (hf : ContinuousOn f (Vs i ∩ Vs j)) {S : B4}
    (hS : S ∈ Vs i ∩ Vs j) : f S = f (edgeF i j) := by
  have h := hf (edgeF i j) (edgeF_mem i j)
  have hn : f ⁻¹' {f (edgeF i j)} ∈ 𝓝[Vs i ∩ Vs j] edgeF i j :=
    h (isOpen_discrete {f (edgeF i j)} |>.mem_nhds rfl)
  obtain ⟨U, hU, hmem, hsub⟩ := mem_nhdsWithin.mp hn
  exact hsub ⟨subset_of_mem_open hU hmem hS, hS⟩

/-- The triangle `{i, j, k}`. -/
def triF (i j k : Fin 4) : B4 :=
  ⟨{i, j, k}, ⟨i, by simp⟩, (Finset.card_le_three).trans le_rfl⟩

lemma triF_mem (i j k : Fin 4) : triF i j k ∈ Vs i ∩ Vs j ∩ Vs k :=
  ⟨⟨show i ∈ ({i, j, k} : Finset (Fin 4)) by simp, show j ∈ ({i, j, k} : Finset (Fin 4)) by simp⟩,
    show k ∈ ({i, j, k} : Finset (Fin 4)) by simp⟩

/-- The cocycle: `1` on the triples with index set `{0,1,2}`. -/
def c0 (i j k : Fin 4) (_ : B4) : ZMod 2 := if ({i, j, k} : Finset (Fin 4)) = {0, 1, 2} then 1 else 0

lemma c0_identity : ∀ i j k l : Fin 4, ({i, j, k, l} : Finset (Fin 4)).card ≤ 3 →
    c0 j k l (triF 0 1 2) - c0 i k l (triF 0 1 2) + c0 i j l (triF 0 1 2) - c0 i j k (triF 0 1 2) = 0 := by
  unfold c0; decide

/-- **`c0` is a Čech 2-cocycle.** -/
theorem c0_cocycle : Gen.IsCocycle2 Vs c0 := by
  intro i j k l y hy
  have hsub : ({i, j, k, l} : Finset (Fin 4)) ⊆ y.1 := by
    intro a ha
    simp only [Finset.mem_insert, Finset.mem_singleton] at ha
    rcases ha with rfl | rfl | rfl | rfl
    exacts [hy.1.1.1, hy.1.1.2, hy.1.2, hy.2]
  exact c0_identity i j k l ((Finset.card_le_card hsub).trans y.2.2)

/-- **`c0` is not a coboundary**: the ℤ/2 Čech cohomology of this cover is nonzero. -/
theorem c0_not_cobdy : ¬ Gen.IsCobdy Vs c0 := by
  rintro ⟨b, hb, he⟩
  have hβ : ∀ i j k, b j k (triF i j k) = b j k (edgeF j k) ∧ b i k (triF i j k) = b i k (edgeF i k) ∧
      b i j (triF i j k) = b i j (edgeF i j) := fun i j k =>
    ⟨eq_on_overlap (hb j k) ⟨(triF_mem i j k).1.2, (triF_mem i j k).2⟩,
      eq_on_overlap (hb i k) ⟨(triF_mem i j k).1.1, (triF_mem i j k).2⟩,
      eq_on_overlap (hb i j) (triF_mem i j k).1⟩
  have e : ∀ i j k : Fin 4, c0 i j k (triF i j k) =
      b j k (edgeF j k) - b i k (edgeF i k) + b i j (edgeF i j) := fun i j k => by
    have := he i j k (triF i j k) (triF_mem i j k)
    simp only [Pi.zero_apply, zero_add, Gen.δ1] at this
    rw [this, (hβ i j k).1, (hβ i j k).2.1, (hβ i j k).2.2]
  have e012 := e 0 1 2
  have e013 := e 0 1 3
  have e023 := e 0 2 3
  have e123 := e 1 2 3
  have v012 : c0 0 1 2 (triF 0 1 2) = 1 := by unfold c0; decide
  have v013 : c0 0 1 3 (triF 0 1 3) = 0 := by unfold c0; decide
  have v023 : c0 0 2 3 (triF 0 2 3) = 0 := by unfold c0; decide
  have v123 : c0 1 2 3 (triF 1 2 3) = 0 := by unfold c0; decide
  rw [v012] at e012; rw [v013] at e013; rw [v023] at e023; rw [v123] at e123
  have : (1 : ZMod 2) = 0 := by linear_combination e012 - e013 + e023 - e123
  exact absurd this (by decide)

end

end GU.Library
