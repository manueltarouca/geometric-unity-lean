import GU.Spinor.Gamma
import GU.Bundle.TimeOrientation
import GU.Spinor.Dirac

/-!
# Phase 6, item 6: the two-component `Spin(7,7)` and the spinor forms

`hyp k = e_k f_k` (`e_k` the `k`-th positive and `f_k` the `k`-th negative basis vector) is a hyperbolic
element: the boosts `cosh t + sinh t · hyp k` lie in `Spin⁺(7,7)` (`boost`, `boost_val`). Hence:

* **`flip_hyp`**: every bilinear form on the Dirac module `ℝ¹²⁸` invariant under `Spin⁺(7,7)` changes
  sign under `hyp k`;
* **`flip_omega`**: it changes sign under `ω = hyp 0 ⋯ hyp 6` (the volume element up to sign).

`ω` anticommutes with every vector (`omega_anticomm`), squares to `1` (`omega_sq`), commutes with
`Spin⁺(7,7)` (`omega_comm_spin`) and is not in it (`omega_not_mem`). **`SpinPM`**, the group generated by
`Spin⁺(7,7)` and `ω` (`emb_injective`; our model of the two-component group, its identification with the
standard one is informal), maps onto `SO₀(7,7) ∪ (−1)·SO₀(7,7)` with kernel `{±1}` (`toO_ker`, `range_toO`),
inside `{det = 1}` (`det_toO`); `−1` is outside `SO₀` (`tdet_negO`, `negO_not_mem`). `toO` is the action on
vectors by conjugation (`toO_spec`). That `SO₀ ∪ (−1)·SO₀` is all of `SO(7,7)` (the `det = 1` part of
`O(7,7)`) is `SO77_eq` and `range_toO_eq` in `O77Components.lean`.
-/

namespace GU.Library

open Matrix GU GU.Observerse GU.Spinor CliffordAlgebra

set_option synthInstance.maxHeartbeats 4000000
set_option maxHeartbeats 4000000

noncomputable section

/-- The `k`-th positive and negative basis vectors. -/
abbrev ep (k : Fin 7) : Fin 14 → ℝ := eb (Fin.castAdd 7 k)
abbrev en (k : Fin 7) : Fin 14 → ℝ := eb (Fin.natAdd 7 k)

lemma Q_ep (k : Fin 7) : Q77 (ep k) = 1 := by
  rw [Q_eb]; simp [Fin.castAdd]

lemma Q_en (k : Fin 7) : Q77 (en k) = -1 := by
  rw [Q_eb]; simp [Fin.natAdd]

lemma Q_boost (k : Fin 7) (c s : ℝ) : Q77 (c • ep k + s • en k) = c ^ 2 - s ^ 2 := by
  have hpol : QuadraticMap.polar Q77 (ep k) (en k) = 0 := by
    apply polar_eb
    intro h
    have := congrArg Fin.val h
    simp [Fin.castAdd, Fin.natAdd] at this
  rw [QuadraticMap.map_add Q77, QuadraticMap.map_smul, QuadraticMap.map_smul, Q_ep, Q_en]
  rw [show QuadraticMap.polar Q77 (c • ep k) (s • en k) = c * s * QuadraticMap.polar Q77 (ep k) (en k) by
    rw [QuadraticMap.polar_smul_left, QuadraticMap.polar_smul_right]; ring, hpol]
  simp; ring

/-- The hyperbolic element `e_k f_k`. -/
def hyp (k : Fin 7) : Cl77 := ι Q77 (ep k) * ι Q77 (en k)

/-- **The boost** `e_k (cosh t e_k + sinh t f_k) ∈ Spin⁺(7,7)`. -/
def boost (k : Fin 7) (t : ℝ) : Spin77 :=
  ⟨ι Q77 (ep k) * ι Q77 (Real.cosh t • ep k + Real.sinh t • en k), pair_mem _ _ (by
    rw [Q_ep, Q_boost, Real.cosh_sq]; ring)⟩

lemma boost_val (k : Fin 7) (t : ℝ) :
    (boost k t : Cl77) = algebraMap ℝ Cl77 (Real.cosh t) + Real.sinh t • hyp k := by
  show ι Q77 (ep k) * ι Q77 (Real.cosh t • ep k + Real.sinh t • en k) = _
  rw [map_add, map_smul, map_smul, mul_add, mul_smul_comm, mul_smul_comm, ι_sq_scalar, Q_ep,
    map_one, hyp, Algebra.algebraMap_eq_smul_one]

/-! ### Invariant forms on the Dirac module -/

/-- The Dirac module. -/
abbrev Sp := Idx → ℝ

/-- The action of `Cl(7,7)` on the Dirac module. -/
def act (x : Cl77) (u : Sp) : Sp := cliffordRep x *ᵥ u

lemma act_mul (x y : Cl77) (u : Sp) : act (x * y) u = act x (act y u) := by
  simp [act, Matrix.mulVec_mulVec]

lemma act_add (x y : Cl77) (u : Sp) : act (x + y) u = act x u + act y u := by
  simp [act, Matrix.add_mulVec]

lemma act_smul (c : ℝ) (x : Cl77) (u : Sp) : act (c • x) u = c • act x u := by
  simp [act, Matrix.smul_mulVec]

lemma act_algebraMap (c : ℝ) (u : Sp) : act (algebraMap ℝ Cl77 c) u = c • u := by
  simp [act, AlgHom.commutes, Algebra.algebraMap_eq_smul_one, Matrix.smul_mulVec]

/-- A bilinear form invariant under `Spin⁺(7,7)`. -/
def IsInvariant (B : LinearMap.BilinForm ℝ Sp) : Prop :=
  ∀ x : Spin77, ∀ u v, B (act x u) (act x v) = B u v

/-- **Each hyperbolic element flips every invariant form.** -/
theorem flip_hyp {B : LinearMap.BilinForm ℝ Sp} (hB : IsInvariant B) (k : Fin 7) (u v : Sp) :
    B (act (hyp k) u) (act (hyp k) v) = -B u v := by
  have key : ∀ t : ℝ, Real.sinh t ^ 2 * (B u v + B (act (hyp k) u) (act (hyp k) v)) +
      Real.cosh t * Real.sinh t * (B (act (hyp k) u) v + B u (act (hyp k) v)) = 0 := by
    intro t
    have h := hB (boost k t) u v
    rw [boost_val, act_add, act_add, act_algebraMap, act_algebraMap, act_smul, act_smul] at h
    simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul] at h
    have hc := Real.cosh_sq t
    linear_combination h - (B u v) * hc
  have h1 := key 1
  have h2 := key (-1)
  rw [Real.sinh_neg, Real.cosh_neg] at h2
  have hs : Real.sinh 1 ≠ 0 := by
    have := Real.sinh_pos_iff.mpr one_pos; exact this.ne'
  have hsum : 2 * Real.sinh 1 ^ 2 * (B u v + B (act (hyp k) u) (act (hyp k) v)) = 0 := by
    linear_combination h1 + h2
  have : B u v + B (act (hyp k) u) (act (hyp k) v) = 0 := by
    have hp : 2 * Real.sinh 1 ^ 2 ≠ 0 := by positivity
    exact (mul_eq_zero.mp hsum).resolve_left hp
  linarith

/-- `ω = hyp 0 · hyp 1 ⋯ hyp 6`, the volume element up to sign. -/
def omega : Cl77 := (List.ofFn hyp).prod

lemma flip_list {B : LinearMap.BilinForm ℝ Sp} (hB : IsInvariant B) (L : List (Fin 7)) (u v : Sp) :
    B (act (L.map hyp).prod u) (act (L.map hyp).prod v) = (-1) ^ L.length * B u v := by
  induction L generalizing u v with
  | nil => simp [act]
  | cons k L ih =>
    simp only [List.map_cons, List.prod_cons, act_mul, List.length_cons]
    rw [flip_hyp hB k, ih]
    ring

/-- **`ω` flips every bilinear form on the Dirac module invariant under `Spin⁺(7,7)`.** -/
theorem flip_omega {B : LinearMap.BilinForm ℝ Sp} (hB : IsInvariant B) (u v : Sp) :
    B (act omega u) (act omega v) = -B u v := by
  have h := flip_list hB (List.ofFn id) u v
  rw [show (List.ofFn id).map hyp = List.ofFn hyp by simp [List.map_ofFn]] at h
  rw [omega, h]
  simp only [List.length_ofFn]
  norm_num

/-! ### `ω` and the vectors -/

lemma ι_anticomm {a b : Fin 14 → ℝ} (h : QuadraticMap.polar Q77 a b = 0) :
    ι Q77 a * ι Q77 b = -(ι Q77 b * ι Q77 a) := by
  have := ι_mul_ι_add_swap (Q := Q77) a b
  rw [h, map_zero] at this
  exact eq_neg_of_add_eq_zero_left this

lemma ep_ne_en (k : Fin 7) : Fin.castAdd 7 k ≠ Fin.natAdd 7 k := by
  intro h; have := congrArg Fin.val h; simp [Fin.castAdd, Fin.natAdd] at this

/-- The sign of `hyp k` against `eb i`. -/
def sgn (k : Fin 7) (i : Fin 14) : ℝ := if i = Fin.castAdd 7 k ∨ i = Fin.natAdd 7 k then -1 else 1

lemma hyp_comm_eb (k : Fin 7) (i : Fin 14) :
    hyp k * ι Q77 (eb i) = sgn k i • (ι Q77 (eb i) * hyp k) := by
  unfold hyp sgn
  have hba : ι Q77 (en k) * ι Q77 (ep k) = -(ι Q77 (ep k) * ι Q77 (en k)) :=
    ι_anticomm (polar_eb (ep_ne_en k).symm)
  by_cases ha : i = Fin.castAdd 7 k
  · subst ha
    rw [if_pos (Or.inl rfl), neg_one_smul]
    show ι Q77 (ep k) * ι Q77 (en k) * ι Q77 (ep k) = -(ι Q77 (ep k) * (ι Q77 (ep k) * ι Q77 (en k)))
    rw [mul_assoc, hba, mul_neg]
  · by_cases hb : i = Fin.natAdd 7 k
    · subst hb
      rw [if_pos (Or.inr rfl), neg_one_smul]
      show ι Q77 (ep k) * ι Q77 (en k) * ι Q77 (en k) = -(ι Q77 (en k) * (ι Q77 (ep k) * ι Q77 (en k)))
      rw [← mul_assoc (ι Q77 (en k)), hba, neg_mul, neg_neg]
    · rw [if_neg (by tauto), one_smul]
      have e1 : ι Q77 (ep k) * ι Q77 (eb i) = -(ι Q77 (eb i) * ι Q77 (ep k)) :=
        ι_anticomm (polar_eb (Ne.symm ha))
      have e2 : ι Q77 (en k) * ι Q77 (eb i) = -(ι Q77 (eb i) * ι Q77 (en k)) :=
        ι_anticomm (polar_eb (Ne.symm hb))
      show ι Q77 (ep k) * ι Q77 (en k) * ι Q77 (eb i) = ι Q77 (eb i) * (ι Q77 (ep k) * ι Q77 (en k))
      calc ι Q77 (ep k) * ι Q77 (en k) * ι Q77 (eb i)
          = ι Q77 (ep k) * (ι Q77 (en k) * ι Q77 (eb i)) := mul_assoc _ _ _
        _ = -(ι Q77 (ep k) * ι Q77 (eb i) * ι Q77 (en k)) := by rw [e2, mul_neg, mul_assoc]
        _ = ι Q77 (eb i) * (ι Q77 (ep k) * ι Q77 (en k)) := by rw [e1, neg_mul, neg_neg, mul_assoc]

lemma hyp_comm_hyp (k l : Fin 7) : hyp k * hyp l = hyp l * hyp k := by
  have h1 := hyp_comm_eb k (Fin.castAdd 7 l)
  have h2 := hyp_comm_eb k (Fin.natAdd 7 l)
  have hs : sgn k (Fin.castAdd 7 l) * sgn k (Fin.natAdd 7 l) = 1 := by
    unfold sgn
    by_cases h : k = l
    · subst h; simp
    · have n1 : Fin.castAdd 7 l ≠ Fin.castAdd 7 k := fun e => h (Fin.castAdd_injective _ _ e).symm
      have n2 : Fin.castAdd 7 l ≠ Fin.natAdd 7 k := fun e => by
        have := congrArg Fin.val e; simp [Fin.castAdd, Fin.natAdd] at this; omega
      have n3 : Fin.natAdd 7 l ≠ Fin.castAdd 7 k := fun e => by
        have := congrArg Fin.val e; simp [Fin.castAdd, Fin.natAdd] at this; omega
      have n4 : Fin.natAdd 7 l ≠ Fin.natAdd 7 k := fun e => h (Fin.natAdd_injective _ _ e).symm
      rw [if_neg (by tauto), if_neg (by tauto), one_mul]
  show hyp k * (ι Q77 (ep l) * ι Q77 (en l)) = ι Q77 (ep l) * ι Q77 (en l) * hyp k
  rw [← mul_assoc, h1, smul_mul_assoc, mul_assoc, h2, mul_smul_comm, smul_smul, hs, one_smul,
    ← mul_assoc]

lemma list_comm_eb (L : List (Fin 7)) (i : Fin 14) :
    (L.map hyp).prod * ι Q77 (eb i) = (L.map fun k => sgn k i).prod • (ι Q77 (eb i) * (L.map hyp).prod) := by
  induction L with
  | nil => simp
  | cons k L ih =>
    simp only [List.map_cons, List.prod_cons]
    rw [mul_assoc, ih, mul_smul_comm, ← mul_assoc, hyp_comm_eb, smul_mul_assoc, smul_smul, mul_assoc,
      mul_comm (sgn k i)]

lemma sgn_prod (i : Fin 14) : ∏ k : Fin 7, sgn k i = -1 := by
  fin_cases i <;> simp only [Fin.prod_univ_seven, sgn] <;> norm_num [Fin.ext_iff]

/-- **`ω` anticommutes with every basis vector.** -/
lemma omega_anticomm_eb (i : Fin 14) : omega * ι Q77 (eb i) = -(ι Q77 (eb i) * omega) := by
  have h := list_comm_eb (List.ofFn id) i
  rw [show (List.ofFn id).map hyp = List.ofFn hyp by simp [List.map_ofFn],
    show ((List.ofFn id).map fun k : Fin 7 => sgn k i) = List.ofFn fun k : Fin 7 => sgn k i by
      simp [List.map_ofFn],
    List.prod_ofFn, sgn_prod, neg_one_smul] at h
  exact h

/-- **`ω` anticommutes with every vector.** -/
theorem omega_anticomm (v : Fin 14 → ℝ) : omega * ι Q77 v = -(ι Q77 v * omega) := by
  have hv : v = ∑ i, v i • eb i := by
    ext j; simp [eb, Finset.sum_apply, Pi.single_apply]
  rw [hv, map_sum, Finset.mul_sum, Finset.sum_mul, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, mul_smul_comm, omega_anticomm_eb, smul_neg, smul_mul_assoc]

/-- **`ω` commutes with every even element**, in particular with `Spin⁺(7,7)`. -/
theorem omega_comm_even {x : Cl77} (hx : x ∈ evenOdd Q77 0) : omega * x = x * omega := by
  induction x, hx using even_induction with
  | algebraMap r => exact (Algebra.commutes r omega).symm
  | add x y _ _ hx hy => rw [mul_add, add_mul, hx, hy]
  | ι_mul_ι_mul m₁ m₂ x _ ih =>
    rw [← mul_assoc, ← mul_assoc, omega_anticomm, neg_mul, mul_assoc, omega_anticomm, mul_neg, neg_neg,
      mul_assoc, mul_assoc, ih, ← mul_assoc, ← mul_assoc]

theorem omega_comm_spin (x : Spin77) : omega * x = x * omega := by
  have hx : (x : Cl77) ∈ evenOdd Q77 0 := by
    rw [← even_toSubmodule]; exact (spinGroup.mem_iff.mp x.2).2
  exact omega_comm_even hx

lemma hyp_sq (k : Fin 7) : hyp k * hyp k = 1 := by
  unfold hyp
  have hba : ι Q77 (en k) * ι Q77 (ep k) = -(ι Q77 (ep k) * ι Q77 (en k)) :=
    ι_anticomm (polar_eb (ep_ne_en k).symm)
  rw [show ι Q77 (ep k) * ι Q77 (en k) * (ι Q77 (ep k) * ι Q77 (en k)) =
      ι Q77 (ep k) * (ι Q77 (en k) * ι Q77 (ep k)) * ι Q77 (en k) by simp only [mul_assoc],
    hba, mul_neg, neg_mul, ← mul_assoc, ι_sq_scalar, mul_assoc, ι_sq_scalar, Q_ep, Q_en, ← map_mul]
  simp

/-- **`ω² = 1`.** -/
theorem omega_sq : omega * omega = 1 := by
  have key : ∀ L : List (Fin 7), (L.map hyp).prod * (L.map hyp).prod = 1 := by
    intro L
    induction L with
    | nil => simp
    | cons k L ih =>
      simp only [List.map_cons, List.prod_cons]
      have hc : ∀ M : List (Fin 7), (M.map hyp).prod * hyp k = hyp k * (M.map hyp).prod := by
        intro M
        induction M with
        | nil => simp
        | cons l M ihM =>
          simp only [List.map_cons, List.prod_cons]
          rw [mul_assoc, ihM, ← mul_assoc, hyp_comm_hyp l k, mul_assoc]
      rw [mul_assoc, ← mul_assoc (L.map hyp).prod, hc L, mul_assoc, ih, mul_one, hyp_sq]
  have := key (List.ofFn id)
  rwa [show (List.ofFn id).map hyp = List.ofFn hyp by simp [List.map_ofFn]] at this
/-! ### Non-vacuity: the invariant form `C`, and `ω ∉ Spin⁺(7,7)` -/

/-- The bilinear form of the matrix `C` of `Dirac.lean`. -/
def formC : LinearMap.BilinForm ℝ Sp := Matrix.toBilin' C

lemma formC_apply (u v : Sp) : formC u v = u ⬝ᵥ (C *ᵥ v) := Matrix.toBilin'_apply' C u v

lemma dot_mulVec_left (A : M128) (u w : Sp) : (A *ᵥ u) ⬝ᵥ w = u ⬝ᵥ (Aᵀ *ᵥ w) := by
  rw [dotProduct_comm, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, dotProduct_comm]

/-- **`C` is an invariant form**, so `flip_hyp` and `flip_omega` are not vacuous. -/
theorem isInvariant_formC : IsInvariant formC := by
  intro x u v
  rw [formC_apply, formC_apply, act, act, dot_mulVec_left, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
    spin_preserves_C]

lemma C_ne_zero : (C : M128) ≠ 0 := by
  intro h
  have := C_mul_C
  rw [h, zero_mul] at this
  exact zero_ne_one this

/-- **`ω` is not in `Spin⁺(7,7)`.** -/
theorem omega_not_mem : omega ∉ Spin77 := by
  intro hω
  apply C_ne_zero
  have h0 : ∀ u v, formC u v = 0 := by
    intro u v
    have h1 := isInvariant_formC ⟨omega, hω⟩ u v
    have h2 := flip_omega isInvariant_formC u v
    have e1 : act ((⟨omega, hω⟩ : Spin77) : Cl77) u = act omega u := rfl
    have e2 : act ((⟨omega, hω⟩ : Spin77) : Cl77) v = act omega v := rfl
    rw [e1, e2] at h1
    linarith
  ext i j
  have := h0 (Pi.single i 1) (Pi.single j 1)
  rw [formC_apply] at this
  simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using this

/-! ### The two-component group -/

lemma mz2_cases (s : Multiplicative (ZMod 2)) : s = 1 ∨ s = Multiplicative.ofAdd 1 := by
  obtain ⟨a, rfl⟩ := Multiplicative.ofAdd.surjective s
  fin_cases a
  · left; rfl
  · right; rfl

lemma ofAdd_one_ne : (Multiplicative.ofAdd (1 : ZMod 2)) ≠ 1 := by decide

lemma ofAdd_one_sq : Multiplicative.ofAdd (1 : ZMod 2) * Multiplicative.ofAdd 1 = 1 := by decide

/-- `ω^s` for `s ∈ ℤ/2`. -/
def omPow (s : Multiplicative (ZMod 2)) : Cl77 := if s = 1 then 1 else omega

lemma omPow_one' : omPow 1 = 1 := if_pos rfl
lemma omPow_gen : omPow (Multiplicative.ofAdd 1) = omega := if_neg ofAdd_one_ne

lemma omPow_mul (s t : Multiplicative (ZMod 2)) : omPow (s * t) = omPow s * omPow t := by
  rcases mz2_cases s with rfl | rfl <;> rcases mz2_cases t with rfl | rfl
  · simp [omPow_one']
  · simp [omPow_one']
  · simp [omPow_one']
  · rw [ofAdd_one_sq, omPow_one', omPow_gen, omega_sq]

lemma omPow_comm (s : Multiplicative (ZMod 2)) (x : Spin77) : omPow s * x = x * omPow s := by
  rcases mz2_cases s with rfl | rfl
  · simp [omPow_one']
  · rw [omPow_gen]; exact omega_comm_spin x

/-- **The two-component group** `Spin⁺(7,7) × {1, ω}` (`ω` is central of order two in `Spin⁺ ⊔ Spin⁺ω`;
our model of the two-component `Spin(7,7)`, the identification with `Pin ∩ Cl⁰` is informal). -/
abbrev SpinPM := Spin77 × Multiplicative (ZMod 2)

/-- Its embedding in `Cl(7,7)`: `(x, s) ↦ x ω^s`. -/
def emb : SpinPM →* Cl77 where
  toFun g := (g.1 : Cl77) * omPow g.2
  map_one' := by simp [omPow_one']
  map_mul' g h := by
    show (g.1 * h.1 : Cl77) * omPow (g.2 * h.2) = (g.1 : Cl77) * omPow g.2 * ((h.1 : Cl77) * omPow h.2)
    rw [omPow_mul]
    simp only [mul_assoc]
    rw [← mul_assoc (omPow g.2) (h.1 : Cl77), omPow_comm, mul_assoc]

/-- **The embedding is injective**: `ω ∉ Spin⁺`. -/
theorem emb_injective : Function.Injective emb := by
  rintro ⟨x, s⟩ ⟨y, t⟩ h
  have h' : (x : Cl77) * omPow s = y * omPow t := h
  have hx : star (x : Cl77) * x = 1 := spinGroup.star_mul_self_of_mem x.2
  have hy : star (y : Cl77) * y = 1 := spinGroup.star_mul_self_of_mem y.2
  rcases mz2_cases s with rfl | rfl <;> rcases mz2_cases t with rfl | rfl
  · rw [omPow_one', mul_one, mul_one] at h'
    exact Prod.ext (Subtype.ext h') rfl
  · exfalso; apply omega_not_mem
    rw [omPow_one', mul_one, omPow_gen] at h'
    have : omega = star (y : Cl77) * x := by rw [h', ← mul_assoc, hy, one_mul]
    rw [this]; exact mul_mem (spinGroup.star_mem y.2) x.2
  · exfalso; apply omega_not_mem
    rw [omPow_one', mul_one, omPow_gen] at h'
    have : omega = star (x : Cl77) * y := by rw [← h', ← mul_assoc, hx, one_mul]
    rw [this]; exact mul_mem (spinGroup.star_mem x.2) y.2
  · rw [omPow_gen] at h'
    refine Prod.ext (Subtype.ext ?_) rfl
    have := congrArg (· * omega) h'
    simpa [mul_assoc, omega_sq] using this

/-- **The non-identity component flips every invariant form.** -/
theorem flip_nonidentity {B : LinearMap.BilinForm ℝ Sp} (hB : IsInvariant B) (x : Spin77) (u v : Sp) :
    B (act (emb (x, Multiplicative.ofAdd 1)) u) (act (emb (x, Multiplicative.ofAdd 1)) v) = -B u v := by
  have e : emb (x, Multiplicative.ofAdd 1) = (x : Cl77) * omega := by
    show (x : Cl77) * omPow (Multiplicative.ofAdd 1) = _
    rw [omPow_gen]
  rw [e, act_mul, act_mul, hB x, flip_omega hB]

/-! ### The double cover -/

/-- `−1 ∈ O(7,7)`. -/
def negO : O77 := ⟨Matrix.of.symm (-1 : Matrix (Fin 14) (Fin 14) ℝ), by
  rw [mem_Orth_iff_mat]; show (-1 : Matrix (Fin 14) (Fin 14) ℝ)ᵀ * _ * (-1) = _; simp⟩

lemma negO_sq : negO * negO = 1 := by
  apply Subtype.ext
  show mulM _ _ = Matrix.of.symm (1 : Matrix (Fin 14) (Fin 14) ℝ)
  unfold mulM; simp [negO]

lemma negO_comm (g : O77) : negO * g = g * negO := by
  apply Subtype.ext
  show mulM _ _ = mulM _ _
  unfold mulM; simp [negO]

/-- **`−1` reverses the orientation of the positive part**: `tdet (−1) = −1`, so `−1 ∉ SO₀`. -/
lemma tdet_negO : tdet (negO : Mat 14) = -1 := by
  have : posBlock (negO : Mat 14) = -1 := by
    ext a b
    show (-1 : Matrix (Fin 14) (Fin 14) ℝ) (Fin.castAdd 7 a) (Fin.castAdd 7 b) = _
    by_cases h : a = b
    · subst h; simp
    · have h' : (Fin.castAdd 7 a : Fin (7 + 7)) ≠ Fin.castAdd 7 b := fun e => h (Fin.castAdd_injective _ _ e)
      simp [Matrix.one_apply, h, h']
  unfold tdet; rw [this, Matrix.det_neg]; norm_num

lemma negO_not_mem : negO ∉ SO0 := fun h => by
  have := tdet_pos_of_mem_SO0 h; rw [tdet_negO] at this; norm_num at this

/-- `(−1)^s`. -/
def negPow (s : Multiplicative (ZMod 2)) : O77 := if s = 1 then 1 else negO

lemma negPow_one' : negPow 1 = 1 := if_pos rfl
lemma negPow_gen : negPow (Multiplicative.ofAdd 1) = negO := if_neg ofAdd_one_ne

lemma negPow_mul (s t : Multiplicative (ZMod 2)) : negPow (s * t) = negPow s * negPow t := by
  rcases mz2_cases s with rfl | rfl <;> rcases mz2_cases t with rfl | rfl
  · simp [negPow_one']
  · simp [negPow_one']
  · simp [negPow_one']
  · rw [ofAdd_one_sq, negPow_one', negPow_gen, negO_sq]

lemma negPow_comm (s : Multiplicative (ZMod 2)) (g : O77) : negPow s * g = g * negPow s := by
  rcases mz2_cases s with rfl | rfl
  · simp [negPow_one']
  · rw [negPow_gen]; exact negO_comm g

/-- **The map of the two-component group to `O(7,7)`**: `(x, s) ↦ ρ(x) (−1)^s`; on the Clifford side
`ω` acts on vectors by `−1` (`omega_anticomm`). -/
def toO : SpinPM →* O77 where
  toFun g := spinToO77 g.1 * negPow g.2
  map_one' := by simp [negPow_one']
  map_mul' g h := by
    show spinToO77 (g.1 * h.1) * negPow (g.2 * h.2) = spinToO77 g.1 * negPow g.2 * (spinToO77 h.1 * negPow h.2)
    rw [map_mul, negPow_mul]
    simp only [mul_assoc]
    rw [← mul_assoc (negPow g.2) (spinToO77 h.1), negPow_comm g.2 (spinToO77 h.1), mul_assoc]

/-- **The kernel is `{±1}`**: a double cover onto its image. -/
theorem toO_ker (g : SpinPM) : toO g = 1 ↔ g = 1 ∨ g = (negOne, 1) := by
  obtain ⟨x, s⟩ := g
  rcases mz2_cases s with rfl | rfl
  · show spinToO77 x * negPow 1 = 1 ↔ _
    rw [negPow_one', mul_one, spinToO77_eq_one_iff]
    constructor
    · rintro (rfl | rfl)
      · left; rfl
      · right; rfl
    · rintro (h | h)
      · left; exact congrArg Prod.fst h
      · right; exact congrArg Prod.fst h
  · show spinToO77 x * negPow (Multiplicative.ofAdd 1) = 1 ↔ _
    rw [negPow_gen]
    constructor
    · intro h
      exfalso
      have : spinToO77 x = negO := by
        have := congrArg (· * negO) h
        simpa [mul_assoc, negO_sq] using this
      exact negO_not_mem (this ▸ spinToO77_mem x)
    · rintro (h | h)
      · exact absurd (congrArg Prod.snd h) ofAdd_one_ne
      · exact absurd (congrArg Prod.snd h) ofAdd_one_ne

/-- **The image is `SO₀(7,7) ∪ (−1)·SO₀(7,7)`.** -/
theorem range_toO : Set.range toO = {g : O77 | g ∈ SO0 ∨ negO * g ∈ SO0} := by
  ext g
  constructor
  · rintro ⟨⟨x, s⟩, rfl⟩
    rcases mz2_cases s with rfl | rfl
    · left
      show spinToO77 x * negPow 1 ∈ SO0
      rw [negPow_one', mul_one]; exact spinToO77_mem x
    · right
      show negO * (spinToO77 x * negPow (Multiplicative.ofAdd 1)) ∈ SO0
      rw [negPow_gen, negO_comm, mul_assoc, negO_sq, mul_one]
      exact spinToO77_mem x
  · rintro (h | h)
    · obtain ⟨x, hx⟩ := spinToSO0_surjective ⟨g, h⟩
      refine ⟨(x, 1), ?_⟩
      show spinToO77 x * negPow 1 = g
      rw [negPow_one', mul_one]; exact congrArg Subtype.val hx
    · obtain ⟨x, hx⟩ := spinToSO0_surjective ⟨negO * g, h⟩
      refine ⟨(x, Multiplicative.ofAdd 1), ?_⟩
      show spinToO77 x * negPow (Multiplicative.ofAdd 1) = g
      rw [negPow_gen, show spinToO77 x = negO * g from congrArg Subtype.val hx, negO_comm, mul_assoc,
        negO_sq, mul_one]

/-! ### `det = 1`, and `toO` is the action on vectors -/

lemma det_sq_O77 (g : O77) : (Matrix.of (g : Mat 14)).det ^ 2 = 1 := by
  have h := (mem_Orth_iff_mat η77 (ηSig_mem 7 7) (g : Mat 14)).mp g.2
  have hd := congrArg Matrix.det h
  rw [det_mul, det_mul, det_transpose] at hd
  have he : (Matrix.of η77).det = -1 := by
    rw [show Matrix.of η77 = Matrix.diagonal fun i : Fin 14 => if (i : ℕ) < 7 then (1 : ℝ) else -1 from rfl,
      det_diagonal]; simp [Fin.prod_univ_succ]
  rw [he] at hd
  nlinarith [hd]

lemma continuous_detO : Continuous fun g : O77 => (Matrix.of (g : Mat 14)).det :=
  (show Continuous fun g : O77 => Matrix.of (g : Mat 14) from continuous_subtype_val).matrix_det

/-- **`det = 1` on `SO₀(7,7)`.** -/
lemma det_SO0 {g : O77} (hg : g ∈ SO0) : (Matrix.of (g : Mat 14)).det = 1 := by
  set S : Set O77 := {g | (Matrix.of (g : Mat 14)).det = 1}
  have hS : S = {k : O77 | 0 < (Matrix.of (k : Mat 14)).det} := by
    ext k
    simp only [S, Set.mem_setOf_eq]
    constructor
    · intro h; rw [h]; exact one_pos
    · intro h
      have := det_sq_O77 k
      nlinarith [this, h]
  have hc : IsClopen S := by
    refine ⟨isClosed_eq continuous_detO continuous_const, ?_⟩
    rw [hS]; exact isOpen_lt continuous_const continuous_detO
  have h1 : (1 : O77) ∈ S := by
    show (Matrix.of (Matrix.of.symm (1 : Matrix (Fin 14) (Fin 14) ℝ))).det = 1
    simp
  exact hc.connectedComponent_subset h1 hg

/-- **The image of the two-component group lies in `det = 1`.** -/
theorem det_toO (g : SpinPM) : (Matrix.of (toO g : Mat 14)).det = 1 := by
  obtain ⟨x, s⟩ := g
  rcases mz2_cases s with rfl | rfl
  · show (Matrix.of ((spinToO77 x * negPow 1 : O77) : Mat 14)).det = 1
    rw [negPow_one', mul_one]; exact det_SO0 (spinToO77_mem x)
  · show (Matrix.of ((spinToO77 x * negPow (Multiplicative.ofAdd 1) : O77) : Mat 14)).det = 1
    rw [negPow_gen]
    show (Matrix.of (mulM _ _)).det = 1
    unfold mulM
    rw [Equiv.apply_symm_apply, det_mul, det_SO0 (spinToO77_mem x)]
    show 1 * (Matrix.of (Matrix.of.symm (-1 : Matrix (Fin 14) (Fin 14) ℝ))).det = 1
    simp [Matrix.det_neg]; norm_num

lemma ι_spinToO77 (x : Spin77) (v : Fin 14 → ℝ) :
    ι Q77 (Matrix.of (spinToO77 x : Mat 14) *ᵥ v) * (x : Cl77) = (x : Cl77) * ι Q77 v := by
  have h1 : Matrix.of (spinToO77 x : Mat 14) *ᵥ v = vecL x v := of_spinMat_mulVec x v
  rw [h1, ι_vecL, mul_assoc, spinGroup.star_mul_self_of_mem x.2, mul_one]

/-- **`toO` is the action on vectors by conjugation**: `g v g⁻¹ = toO(g) v` in `Cl(7,7)`. -/
theorem toO_spec (g : SpinPM) (v : Fin 14 → ℝ) :
    ι Q77 (Matrix.of (toO g : Mat 14) *ᵥ v) * emb g = emb g * ι Q77 v := by
  obtain ⟨x, s⟩ := g
  rcases mz2_cases s with rfl | rfl
  · have e1 : (toO (x, 1) : Mat 14) = (spinToO77 x : Mat 14) := by
      show ((spinToO77 x * negPow 1 : O77) : Mat 14) = _
      rw [negPow_one', mul_one]
    have e2 : emb (x, 1) = (x : Cl77) := by
      show (x : Cl77) * omPow 1 = _
      rw [omPow_one', mul_one]
    rw [e1, e2, ι_spinToO77]
  · have e1 : Matrix.of (toO (x, Multiplicative.ofAdd 1) : Mat 14) *ᵥ v =
        -(Matrix.of (spinToO77 x : Mat 14) *ᵥ v) := by
      show Matrix.of ((spinToO77 x * negPow (Multiplicative.ofAdd 1) : O77) : Mat 14) *ᵥ v = _
      rw [negPow_gen]
      show Matrix.of (mulM _ _) *ᵥ v = _
      unfold mulM
      rw [Equiv.apply_symm_apply]
      show (Matrix.of (spinToO77 x : Mat 14) * Matrix.of (Matrix.of.symm (-1 : Matrix (Fin 14) (Fin 14) ℝ)))
        *ᵥ v = _
      simp only [Equiv.apply_symm_apply, Matrix.mul_neg, Matrix.mul_one]
      exact Matrix.neg_mulVec _ _
    have e2 : emb (x, Multiplicative.ofAdd 1) = (x : Cl77) * omega := by
      show (x : Cl77) * omPow (Multiplicative.ofAdd 1) = _
      rw [omPow_gen]
    rw [e1, e2, map_neg, neg_mul, ← mul_assoc, ι_spinToO77, mul_assoc, mul_assoc, omega_anticomm,
      mul_neg]

end

