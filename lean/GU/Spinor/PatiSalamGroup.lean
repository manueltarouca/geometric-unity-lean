import GU.Spinor.SpinDet

/-!
# Commuting `Spin(6)`, `Spin(4)` inside `Spin(7,7)`: the Pati–Salam group `(Spin(6) × Spin(4))/ℤ₂`

Coordinates: `Q77 = diag(+1 ×7, −1 ×7)`. `W6 = span(e₁..e₆)` (positive, fiber), `W4 = span(e₁₀..e₁₃)`
(negative, fiber); `e₀` and `e₇,e₈,e₉` carry the base (1,3). These are the same blocks as the
gamma-matrix `pos6`/`neg4` of `PatiSalam.lean` (via `gen i = (i % 7, 7 ≤ i)`, `Gamma.lean`).

* `pair_mem`: `ι a · ι b ∈ Spin(7,7)` whenever `Q a · Q b = 1`.
* `Spin6`, `Spin4`: subgroups of `Spin(7,7)` generated by `ι a ι b` with `a, b ∈ W6` unit
  (`Q = 1`), resp. `a, b ∈ W4` with `Q = −1` (the even products of unit vectors: `Spin(6)`, `Spin(4)`).
* **`spin6_spin4_commute`**: every element of `Spin6` commutes with every element of `Spin4`.
* **`spin6_fixes`, `spin4_fixes`**: `Spin6` acts trivially (via `vecRep`) on every vector
  `Q`-orthogonal to `W6`, and `Spin4` on every vector orthogonal to `W4`; in particular both fix the
  base directions (`base_fixed`), `Spin6` fixes `W4` and `Spin4` fixes `W6` (`spin6_fixes_W4`,
  `spin4_fixes_W6`). `spin6_preserves_W6`, `spin4_preserves_W4`: each preserves its own block, so the
  action is block-diagonal on `ℝ¹⁴ = base ⊕ W6 ⊕ W4`.
* `neg_one_mem_Spin6`, `neg_one_mem_Spin4`, **`product_not_injective`**: `−1` lies in both, so the
  product map `Spin6 × Spin4 → Spin(7,7)` has kernel containing `(−1,−1)`: the embedded group is
  `(Spin(6) × Spin(4))/ℤ₂`, as usual. `spin6_nontrivial`: `e₁e₂` acts as `−1` on `e₁`.

On `W6` (positive definite) and `W4` (negative definite) the spinor-norm condition is automatic, so the
generators are the standard ones for `Spin(6)` and `Spin(0,4) ≅ Spin(4)`. `BlockSpin.lean`: each is a
non-split double cover of its block `SO(6)` / `SO(4)` (`range_spin6/4`, `spin6/4_ker`, `spin6/4_nonsplit`).
`Spin4 ≃* spinGroup Q₄` (Mathlib's abstract `Spin(0,4)`): `spin4Equiv`, `SpinIso.lean`. Likewise `Spin6 ≃* spinGroup Q₆`
(`spin6Equiv`, `SpinIso6.lean`). `Spin4 ≃* Sp(1) × Sp(1)`: `spin4QuatEquiv`,
`SpinQuat.lean`. `Spin4 ≃* SU(2) × SU(2)`: `spin4SU2Equiv`, `SpinSU2.lean`.
`Spin6 ≃* SU(4)`: `Spin6SU4` (`SU4Onto.lean`). Not proved: topology (no Lie group theory here). **`spin6_inf_spin4_eq`**:
`Spin6 ∩ Spin4 = {±1}`, and the product map has kernel exactly `{(1,1), (−1,−1)}` (`product_kernel`).
-/

namespace GU.Spinor

open CliffordAlgebra

/-- Support in a set of coordinates. -/
def SuppIn (S : Finset (Fin 14)) (v : Fin 14 → ℝ) : Prop := ∀ i, i ∉ S → v i = 0

def S6 : Finset (Fin 14) := {1, 2, 3, 4, 5, 6}
def S4 : Finset (Fin 14) := {10, 11, 12, 13}

lemma polar_Q77 (a c : Fin 14 → ℝ) :
    QuadraticMap.polar Q77 a c = 2 * ∑ i : Fin 14, (if (i : ℕ) < 7 then (1 : ℝ) else -1) * (a i * c i) := by
  simp only [QuadraticMap.polar, Q77, QuadraticMap.weightedSumSquares_apply, Pi.add_apply, smul_eq_mul]
  rw [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

lemma polar_disjoint {S T : Finset (Fin 14)} (hST : Disjoint S T) {a c : Fin 14 → ℝ}
    (ha : SuppIn S a) (hc : SuppIn T c) : QuadraticMap.polar Q77 a c = 0 := by
  rw [polar_Q77]
  have : ∀ i, a i * c i = 0 := fun i => by
    by_cases hi : i ∈ S
    · rw [hc i (Finset.disjoint_left.mp hST hi), mul_zero]
    · rw [ha i hi, zero_mul]
  simp [this]

/-- Orthogonal vectors anticommute. -/
lemma ι_anticomm {a c : Fin 14 → ℝ} (h : QuadraticMap.polar Q77 a c = 0) :
    ι Q77 a * ι Q77 c = -(ι Q77 c * ι Q77 a) := by
  have := ι_mul_ι_add_swap (Q := Q77) a c
  rw [h, map_zero] at this
  exact eq_neg_of_add_eq_zero_left this

/-- A product of two vectors commutes with any vector orthogonal to both. -/
lemma pair_comm {a b c : Fin 14 → ℝ} (ha : QuadraticMap.polar Q77 a c = 0)
    (hb : QuadraticMap.polar Q77 b c = 0) :
    ι Q77 a * ι Q77 b * ι Q77 c = ι Q77 c * (ι Q77 a * ι Q77 b) := by
  rw [mul_assoc, ι_anticomm hb, mul_neg, ← mul_assoc, ι_anticomm ha, neg_mul, neg_neg, mul_assoc]

lemma unit_vec_mem (a : Fin 14 → ℝ) (ha : Q77 a ≠ 0) :
    ∃ u : Cl77ˣ, (u : Cl77) = ι Q77 a ∧ u ∈ lipschitzGroup Q77 := by
  let u : Cl77ˣ := ⟨ι Q77 a, (Q77 a)⁻¹ • ι Q77 a, by
      rw [mul_smul_comm, ι_sq_scalar, Algebra.algebraMap_eq_smul_one, smul_smul, inv_mul_cancel₀ ha, one_smul],
    by rw [smul_mul_assoc, ι_sq_scalar, Algebra.algebraMap_eq_smul_one, smul_smul, inv_mul_cancel₀ ha,
      one_smul]⟩
  exact ⟨u, rfl, Subgroup.subset_closure ⟨a, rfl⟩⟩

/-- **`ι a ι b ∈ Spin(7,7)`** when `Q a · Q b = 1`. -/
theorem pair_mem (a b : Fin 14 → ℝ) (h : Q77 a * Q77 b = 1) :
    ι Q77 a * ι Q77 b ∈ spinGroup Q77 := by
  have ha : Q77 a ≠ 0 := left_ne_zero_of_mul_eq_one h
  have hb : Q77 b ≠ 0 := right_ne_zero_of_mul_eq_one h
  obtain ⟨u, hu, hul⟩ := unit_vec_mem a ha
  obtain ⟨w, hw, hwl⟩ := unit_vec_mem b hb
  have hstar : star (ι Q77 a * ι Q77 b) = ι Q77 b * ι Q77 a := by
    rw [star_mul, CliffordAlgebra.star_ι, CliffordAlgebra.star_ι, neg_mul_neg]
  refine spinGroup.mem_iff.mpr ⟨pinGroup.mem_iff.mpr ⟨⟨u * w, (lipschitzGroup Q77).mul_mem hul hwl, ?_⟩, ?_⟩, ?_⟩
  · simp [hu, hw]
  · rw [Unitary.mem_iff, hstar]
    constructor
    · rw [show ι Q77 b * ι Q77 a * (ι Q77 a * ι Q77 b) = ι Q77 b * (ι Q77 a * ι Q77 a) * ι Q77 b by
        simp only [mul_assoc], ι_sq_scalar, ← Algebra.commutes, mul_assoc, ι_sq_scalar, ← map_mul,
        h, map_one]
    · rw [show ι Q77 a * ι Q77 b * (ι Q77 b * ι Q77 a) = ι Q77 a * (ι Q77 b * ι Q77 b) * ι Q77 a by
        simp only [mul_assoc], ι_sq_scalar, ← Algebra.commutes, mul_assoc, ι_sq_scalar, ← map_mul,
        mul_comm (Q77 b), h, map_one]
  · exact ι_mul_ι_mem_evenOdd_zero Q77 a b

/-- Generators: products of two unit vectors supported in `S` with `Q = q`. -/
def gens (S : Finset (Fin 14)) (q : ℝ) : Set Spin77 :=
  {x | ∃ a b, SuppIn S a ∧ SuppIn S b ∧ Q77 a = q ∧ Q77 b = q ∧ (x : Cl77) = ι Q77 a * ι Q77 b}

/-- `Spin(6)`: generated by products of two unit vectors of `W6`. -/
def Spin6 : Subgroup Spin77 := Subgroup.closure (gens S6 1)
/-- `Spin(4)`: generated by products of two (negative) unit vectors of `W4`. -/
def Spin4 : Subgroup Spin77 := Subgroup.closure (gens S4 (-1))

lemma S6_S4_disj : Disjoint S6 S4 := by decide

lemma gens_commute {x y : Spin77} (hx : x ∈ gens S6 1) (hy : y ∈ gens S4 (-1)) : x * y = y * x := by
  obtain ⟨a, b, ha, hb, -, -, ex⟩ := hx
  obtain ⟨c, d, hc, hd, -, -, ey⟩ := hy
  apply Subtype.ext
  rw [Submonoid.coe_mul, Submonoid.coe_mul, ex, ey]
  have h1 := pair_comm (polar_disjoint S6_S4_disj ha hc) (polar_disjoint S6_S4_disj hb hc)
  have h2 := pair_comm (polar_disjoint S6_S4_disj ha hd) (polar_disjoint S6_S4_disj hb hd)
  rw [← mul_assoc, h1, mul_assoc, h2, mul_assoc]

/-- **`Spin(6)` and `Spin(4)` commute elementwise.** -/
theorem spin6_spin4_commute {x y : Spin77} (hx : x ∈ Spin6) (hy : y ∈ Spin4) : x * y = y * x := by
  have h1 : Spin6 ≤ Subgroup.centralizer (gens S4 (-1)) :=
    (Subgroup.closure_le _).mpr fun g hg => Subgroup.mem_centralizer_iff.mpr fun h hh =>
      (gens_commute hg hh).symm
  have h2 : Spin4 ≤ Subgroup.centralizer (Spin6 : Set Spin77) :=
    (Subgroup.closure_le _).mpr fun h hh => Subgroup.mem_centralizer_iff.mpr fun g hg =>
      (Subgroup.mem_centralizer_iff.mp (h1 hg) h hh).symm
  exact Subgroup.mem_centralizer_iff.mp (h2 hy) x hx

/-- Elements fixing every vector of `P` (via `vecRep`). -/
def fixSub (P : Set (Fin 14 → ℝ)) : Subgroup Spin77 where
  carrier := {x | ∀ c ∈ P, vecRep x c = c}
  one_mem' c _ := by rw [map_one]; rfl
  mul_mem' {x y} hx hy c hc := by
    rw [map_mul, LinearEquiv.mul_apply, hy c hc, hx c hc]
  inv_mem' {x} hx c hc := by
    rw [map_inv]
    conv_lhs => rw [← hx c hc]
    exact (vecRep x).symm_apply_apply c

/-- Vectors orthogonal to everything supported in `S`. -/
def perpOf (S : Finset (Fin 14)) : Set (Fin 14 → ℝ) :=
  {c | ∀ a, SuppIn S a → QuadraticMap.polar Q77 a c = 0}

lemma gens_fix {S : Finset (Fin 14)} {q : ℝ} {x : Spin77} (hx : x ∈ gens S q) : x ∈ fixSub (perpOf S) := by
  obtain ⟨a, b, ha, hb, -, -, ex⟩ := hx
  intro c hc
  apply ι_injective
  show ι Q77 (vecL x c) = ι Q77 c
  rw [ι_vecL, ex, pair_comm (hc a ha) (hc b hb), mul_assoc, ← ex,
    spinGroup.mul_star_self_of_mem x.2, mul_one]

/-- **`Spin(6)` acts trivially on `W6^⊥`** (base and `W4`). -/
theorem spin6_fixes {x : Spin77} (hx : x ∈ Spin6) {c : Fin 14 → ℝ} (hc : c ∈ perpOf S6) :
    vecRep x c = c :=
  ((Subgroup.closure_le _).mpr (fun _ hg => gens_fix hg) hx) c hc

/-- **`Spin(4)` acts trivially on `W4^⊥`** (base and `W6`). -/
theorem spin4_fixes {x : Spin77} (hx : x ∈ Spin4) {c : Fin 14 → ℝ} (hc : c ∈ perpOf S4) :
    vecRep x c = c :=
  ((Subgroup.closure_le _).mpr (fun _ hg => gens_fix hg) hx) c hc

/-- `W4 ⊆ W6^⊥` and `W6 ⊆ W4^⊥`: so `Spin6` fixes `W4` pointwise and `Spin4` fixes `W6`. -/
lemma W4_perp6 {c : Fin 14 → ℝ} (hc : SuppIn S4 c) : c ∈ perpOf S6 :=
  fun _ ha => polar_disjoint S6_S4_disj ha hc

lemma W6_perp4 {c : Fin 14 → ℝ} (hc : SuppIn S6 c) : c ∈ perpOf S4 :=
  fun _ ha => polar_disjoint S6_S4_disj.symm ha hc

/-- For orthogonal `a, b`: `(ι a ι b)² = −Q a Q b`. -/
lemma pair_sq {a b : Fin 14 → ℝ} (h : QuadraticMap.polar Q77 b a = 0) :
    ι Q77 a * ι Q77 b * (ι Q77 a * ι Q77 b) = algebraMap ℝ Cl77 (-(Q77 a * Q77 b)) := by
  have key : ι Q77 a * ι Q77 b * (ι Q77 a * ι Q77 b) = -(ι Q77 a * ι Q77 a) * (ι Q77 b * ι Q77 b) := by
    rw [mul_assoc, ← mul_assoc (ι Q77 b), ι_anticomm h]; simp only [mul_neg, neg_mul, mul_assoc]
  rw [key, ι_sq_scalar, ι_sq_scalar, map_neg, neg_mul, ← (algebraMap ℝ Cl77).map_mul, ← map_neg]

/-- (e₁e₂)² = −1, so −1 ∈ Spin6. -/
theorem neg_one_mem_Spin6 : ∃ x ∈ Spin6, (x : Cl77) = -1 := by
  have h1 : Q77 (Pi.single 1 1) = 1 := by
    simp [Q77, QuadraticMap.weightedSumSquares_apply, Pi.single_apply, Finset.sum_ite_eq']
  have h2 : Q77 (Pi.single 2 1) = 1 := by
    simp [Q77, QuadraticMap.weightedSumSquares_apply, Pi.single_apply, Finset.sum_ite_eq']
  have hs : ∀ j : Fin 14, j ∈ S6 → SuppIn S6 (Pi.single j 1) := fun j hj i hi => by
    have : i ≠ j := fun h => hi (h ▸ hj)
    simp [this]
  have hpol : QuadraticMap.polar Q77 (Pi.single (2 : Fin 14) (1:ℝ)) (Pi.single 1 1) = 0 := by
    rw [polar_Q77]; simp [Pi.single_apply]
  let g : Spin77 := ⟨_, pair_mem (Pi.single 1 1) (Pi.single 2 1) (by rw [h1, h2, one_mul])⟩
  have hg : g ∈ Spin6 := Subgroup.subset_closure
    ⟨Pi.single 1 1, Pi.single 2 1, hs 1 (by decide), hs 2 (by decide), h1, h2, rfl⟩
  refine ⟨g * g, Spin6.mul_mem hg hg, ?_⟩
  show ι Q77 (Pi.single 1 1) * ι Q77 (Pi.single 2 1) * (ι Q77 (Pi.single 1 1) * ι Q77 (Pi.single 2 1)) = -1
  rw [pair_sq hpol, h1, h2]; simp

/-- (e₁₀e₁₁)² = −1 too (Q = −1 each), so −1 ∈ Spin4. -/
theorem neg_one_mem_Spin4 : ∃ x ∈ Spin4, (x : Cl77) = -1 := by
  have h1 : Q77 (Pi.single 10 1) = -1 := by
    simp [Q77, QuadraticMap.weightedSumSquares_apply, Pi.single_apply, Finset.sum_ite_eq']
  have h2 : Q77 (Pi.single 11 1) = -1 := by
    simp [Q77, QuadraticMap.weightedSumSquares_apply, Pi.single_apply, Finset.sum_ite_eq']
  have hs : ∀ j : Fin 14, j ∈ S4 → SuppIn S4 (Pi.single j 1) := fun j hj i hi => by
    have : i ≠ j := fun h => hi (h ▸ hj)
    simp [this]
  have hpol : QuadraticMap.polar Q77 (Pi.single (11 : Fin 14) (1:ℝ)) (Pi.single 10 1) = 0 := by
    rw [polar_Q77]; simp [Pi.single_apply]
  let g : Spin77 := ⟨_, pair_mem (Pi.single 10 1) (Pi.single 11 1) (by rw [h1, h2]; norm_num)⟩
  have hg : g ∈ Spin4 := Subgroup.subset_closure
    ⟨Pi.single 10 1, Pi.single 11 1, hs 10 (by decide), hs 11 (by decide), h1, h2, rfl⟩
  refine ⟨g * g, Spin4.mul_mem hg hg, ?_⟩
  show ι Q77 (Pi.single 10 1) * ι Q77 (Pi.single 11 1) * (ι Q77 (Pi.single 10 1) * ι Q77 (Pi.single 11 1)) = -1
  rw [pair_sq hpol, h1, h2]; simp

/-- Sanity: e₁e₂ acts as −1 on e₁, so Spin6 acts nontrivially on W6 (not inside ker vecRep). -/
theorem spin6_nontrivial : ∃ x ∈ Spin6, vecRep x (Pi.single 1 1) = -Pi.single 1 1 := by
  have h1 : Q77 (Pi.single 1 1) = 1 := by
    simp [Q77, QuadraticMap.weightedSumSquares_apply, Pi.single_apply, Finset.sum_ite_eq']
  have h2 : Q77 (Pi.single 2 1) = 1 := by
    simp [Q77, QuadraticMap.weightedSumSquares_apply, Pi.single_apply, Finset.sum_ite_eq']
  have hs : ∀ j : Fin 14, j ∈ S6 → SuppIn S6 (Pi.single j 1) := fun j hj i hi => by
    have : i ≠ j := fun h => hi (h ▸ hj)
    simp [this]
  have hpol : QuadraticMap.polar Q77 (Pi.single (2 : Fin 14) (1:ℝ)) (Pi.single 1 1) = 0 := by
    rw [polar_Q77]; simp [Pi.single_apply]
  let g : Spin77 := ⟨_, pair_mem (Pi.single 1 1) (Pi.single 2 1) (by rw [h1, h2, one_mul])⟩
  have hg : g ∈ Spin6 := Subgroup.subset_closure
    ⟨Pi.single 1 1, Pi.single 2 1, hs 1 (by decide), hs 2 (by decide), h1, h2, rfl⟩
  refine ⟨g, hg, ?_⟩
  apply ι_injective
  show ι Q77 (vecL g (Pi.single 1 1)) = ι Q77 (-Pi.single 1 1)
  rw [ι_vecL, map_neg]
  have hstar : star (g : Cl77) = ι Q77 (Pi.single 2 1) * ι Q77 (Pi.single 1 1) := by
    show star (ι Q77 (Pi.single 1 1) * ι Q77 (Pi.single 2 1)) = _
    rw [star_mul, star_ι, star_ι, neg_mul_neg]
  have hre : (g : Cl77) * ι Q77 (Pi.single 1 1) * star (g : Cl77)
      = (ι Q77 (Pi.single 1 1) * ι Q77 (Pi.single 2 1) * (ι Q77 (Pi.single 1 1) * ι Q77 (Pi.single 2 1)))
        * ι Q77 (Pi.single 1 1) := by
    rw [hstar]; show ι Q77 (Pi.single 1 1) * ι Q77 (Pi.single 2 1) * _ * _ = _; simp only [mul_assoc]
  rw [hre, pair_sq hpol, h1, h2]; simp

/-- **The product `Spin6 × Spin4 → Spin(7,7)` is not injective**: `(−1)·(−1) = 1` with `−1 ≠ 1` in
both factors, so the embedded group is `(Spin(6) × Spin(4))/ℤ₂`. -/
theorem product_not_injective : ∃ x ∈ Spin6, ∃ y ∈ Spin4, x ≠ 1 ∧ x * y = 1 := by
  obtain ⟨x, hx, ex⟩ := neg_one_mem_Spin6
  obtain ⟨y, hy, ey⟩ := neg_one_mem_Spin4
  refine ⟨x, hx, y, hy, fun h => ?_, Subtype.ext ?_⟩
  · have := congrArg Subtype.val h
    rw [ex] at this
    exact neg_one_ne_one_Cl77 this
  · rw [Submonoid.coe_mul, ex, ey, neg_one_mul, neg_neg]; rfl

/-- The base directions `e₀, e₇, e₈, e₉`. -/
def SB : Finset (Fin 14) := {0, 7, 8, 9}

/-- **Both factors fix the base directions** (the (1,3) part of `ℝ¹⁴`). -/
theorem base_fixed {x : Spin77} (hx : x ∈ Spin6 ∨ x ∈ Spin4) {c : Fin 14 → ℝ} (hc : SuppIn SB c) :
    vecRep x c = c := by
  rcases hx with hx | hx
  · exact spin6_fixes hx fun _ ha => polar_disjoint (by decide) ha hc
  · exact spin4_fixes hx fun _ ha => polar_disjoint (by decide) ha hc

/-- `Spin6` fixes `W4` pointwise, `Spin4` fixes `W6` pointwise. -/
theorem spin6_fixes_W4 {x : Spin77} (hx : x ∈ Spin6) {c : Fin 14 → ℝ} (hc : SuppIn S4 c) :
    vecRep x c = c := spin6_fixes hx (W4_perp6 hc)

theorem spin4_fixes_W6 {x : Spin77} (hx : x ∈ Spin4) {c : Fin 14 → ℝ} (hc : SuppIn S6 c) :
    vecRep x c = c := spin4_fixes hx (W6_perp4 hc)


/-- Support complement: a vector supported off `S` is orthogonal to everything supported in `S`. -/
lemma off_perp {S : Finset (Fin 14)} {c : Fin 14 → ℝ} (hc : ∀ i ∈ S, c i = 0) : c ∈ perpOf S := by
  intro a ha
  rw [polar_Q77]
  have : ∀ i, a i * c i = 0 := fun i => by
    by_cases hi : i ∈ S
    · rw [hc i hi, mul_zero]
    · rw [ha i hi, zero_mul]
  simp [this]

/-- **`Spin6 ∩ Spin4 = {±1}`**. -/
theorem spin6_inf_spin4 {x : Spin77} (h6 : x ∈ Spin6) (h4 : x ∈ Spin4) :
    (x : Cl77) = 1 ∨ (x : Cl77) = -1 := by
  refine vecRep_ker x fun v => ?_
  let v6 : Fin 14 → ℝ := fun i => if i ∈ S6 then v i else 0
  have hv : v = v6 + (v - v6) := by abel
  have h6' : SuppIn S6 v6 := fun i hi => by simp [v6, hi]
  have hr : ∀ i ∈ S6, (v - v6) i = 0 := fun i hi => by simp [v6, hi]
  rw [hv, map_add, spin4_fixes_W6 h4 h6', spin6_fixes h6 (off_perp hr)]

/-- With `−1` in both: the intersection is exactly `{1, −1}`. -/
theorem spin6_inf_spin4_eq (x : Spin77) :
    (x ∈ Spin6 ∧ x ∈ Spin4) ↔ ((x : Cl77) = 1 ∨ (x : Cl77) = -1) := by
  constructor
  · rintro ⟨h6, h4⟩; exact spin6_inf_spin4 h6 h4
  · rintro (h | h)
    · have : x = 1 := Subtype.ext h
      subst this; exact ⟨Spin6.one_mem, Spin4.one_mem⟩
    · obtain ⟨y, hy, ey⟩ := neg_one_mem_Spin6
      obtain ⟨z, hz, ez⟩ := neg_one_mem_Spin4
      have e1 : x = y := Subtype.ext (h.trans ey.symm)
      have e2 : x = z := Subtype.ext (h.trans ez.symm)
      exact ⟨e1 ▸ hy, e2 ▸ hz⟩


/-- **Kernel of the product map is `{(1,1), (−1,−1)}`**: `x·y = 1` with `x ∈ Spin6`, `y ∈ Spin4`
forces `x = y⁻¹ = ±1`. -/
theorem product_kernel {x y : Spin77} (hx : x ∈ Spin6) (hy : y ∈ Spin4) (h : x * y = 1) :
    ((x : Cl77) = 1 ∧ (y : Cl77) = 1) ∨ ((x : Cl77) = -1 ∧ (y : Cl77) = -1) := by
  have hxy : x = y⁻¹ := eq_inv_of_mul_eq_one_left h
  have hx4 : x ∈ Spin4 := hxy ▸ Spin4.inv_mem hy
  have hyx : y = x⁻¹ := eq_inv_of_mul_eq_one_right h
  rcases spin6_inf_spin4 hx hx4 with e | e
  · left
    have : x = 1 := Subtype.ext e
    subst this
    exact ⟨rfl, by rw [hyx, inv_one]; rfl⟩
  · right
    refine ⟨e, ?_⟩
    have hxx : x * x = 1 := Subtype.ext (by rw [Submonoid.coe_mul, e, neg_one_mul, neg_neg]; rfl)
    rw [hyx, inv_eq_of_mul_eq_one_right hxx]; exact e


/-- `vecRep` preserves the polar form. -/
lemma vecRep_polar (x : Spin77) (v w : Fin 14 → ℝ) :
    QuadraticMap.polar Q77 (vecRep x v) (vecRep x w) = QuadraticMap.polar Q77 v w := by
  simp only [QuadraticMap.polar, ← map_add, vecRep_isometry]

/-- Elements fixing `S`'s orthogonal complement map vectors supported in `S` to vectors supported
in `S`. -/
lemma preserves_block {S : Finset (Fin 14)} {x : Spin77} (hx : x ∈ fixSub (perpOf S))
    {v : Fin 14 → ℝ} (hv : SuppIn S v) : SuppIn S (vecRep x v) := by
  intro k hk
  have hek : (Pi.single k (1 : ℝ) : Fin 14 → ℝ) ∈ perpOf S :=
    off_perp fun i hi => by
      have : i ≠ k := fun h => hk (h ▸ hi)
      simp [this]
  have h1 : QuadraticMap.polar Q77 (vecRep x v) (Pi.single k 1) = 0 := by
    rw [← hx _ hek, vecRep_polar]; exact hek v hv
  rw [polar_Q77] at h1
  simp only [Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ,
    ite_true] at h1
  split_ifs at h1 with hw <;> linarith

lemma Spin6_le : Spin6 ≤ fixSub (perpOf S6) :=
  (Subgroup.closure_le _).mpr fun _ hg => gens_fix hg
lemma Spin4_le : Spin4 ≤ fixSub (perpOf S4) :=
  (Subgroup.closure_le _).mpr fun _ hg => gens_fix hg

/-- **`Spin6` preserves `W6`, `Spin4` preserves `W4`**: with the fixing statements, both act
block-diagonally on `ℝ¹⁴ = base ⊕ W6 ⊕ W4`. -/
theorem spin6_preserves_W6 {x : Spin77} (hx : x ∈ Spin6) {v : Fin 14 → ℝ} (hv : SuppIn S6 v) :
    SuppIn S6 (vecRep x v) := preserves_block (Spin6_le hx) hv

theorem spin4_preserves_W4 {x : Spin77} (hx : x ∈ Spin4) {v : Fin 14 → ℝ} (hv : SuppIn S4 v) :
    SuppIn S4 (vecRep x v) := preserves_block (Spin4_le hx) hv

end GU.Spinor
