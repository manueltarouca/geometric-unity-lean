import GU.Spinor.SpinKernel

/-!
# The vector representation of `Spin(7,7)` has determinant one

For a unit `u` of `Cl(7,7)` let `A u : a ↦ involute(u) · a · u⁻¹` (twisted adjoint action).
On the Lipschitz group (generated by invertible vectors) `A u` preserves the vectors `V = range ι`,
and, by closure induction, `det (A u|_V) = ±1` with the sign equal to the parity of `u`
(`involute u = ±u`): generators `ι m` act by reflections (`det = −1`, `involute = −1`).
For `x ∈ Spin(7,7)` (even), `A x|_V` is `vecRep x`, so **`det_vecRep : det (vecRep x) = 1`**:
the image of `Spin(7,7)` lies in `SO(7,7)`. The exact image is the spinor-norm kernel `SO⁺(7,7)`, of index 2
(`range_vecRep`, `SpinImage.lean`). It equals the identity component `SO₀(7,7)` (`cc_iff_spin`, `SpinComponent.lean`).
-/

namespace GU.Spinor

open CliffordAlgebra

/-- Twisted adjoint action of a unit. -/
noncomputable def Aμ (u : Cl77ˣ) : Cl77 →ₗ[ℝ] Cl77 :=
  LinearMap.mulLeft ℝ (involute (u : Cl77)) ∘ₗ LinearMap.mulRight ℝ (↑u⁻¹ : Cl77)

lemma Aμ_apply (u : Cl77ˣ) (a : Cl77) : Aμ u a = involute (u : Cl77) * a * ↑u⁻¹ := by
  simp [Aμ, mul_assoc]

lemma Aμ_mul (u v : Cl77ˣ) (a : Cl77) : Aμ (u * v) a = Aμ u (Aμ v a) := by
  simp only [Aμ_apply, Units.val_mul, map_mul, mul_inv_rev, mul_assoc]

lemma Aμ_one (a : Cl77) : Aμ 1 a = a := by simp [Aμ_apply]

/-- The vectors of `Cl(7,7)`. -/
abbrev Vs : Submodule ℝ Cl77 := LinearMap.range (ι Q77)

/-- `u` preserves the vectors. -/
def Good (u : Cl77ˣ) : Prop := ∀ a ∈ Vs, Aμ u a ∈ Vs

/-- The restriction of `A u` to the vectors. -/
noncomputable def Tμ (u : Cl77ˣ) (h : Good u) : Vs →ₗ[ℝ] Vs := (Aμ u).restrict h

lemma Tμ_mul (u v : Cl77ˣ) (hu : Good u) (hv : Good v) (huv : Good (u * v)) :
    Tμ (u * v) huv = Tμ u hu ∘ₗ Tμ v hv := by
  ext a; exact Aμ_mul u v a

lemma Tμ_one (h : Good 1) : Tμ 1 h = LinearMap.id := by
  ext a; exact Aμ_one a

lemma Q_ne_of_unit (u : Cl77ˣ) (m : Fin 14 → ℝ) (hu : (u : Cl77) = ι Q77 m) : Q77 m ≠ 0 := by
  intro h0
  have h2 : (u : Cl77) * u = 0 := by rw [hu, ι_sq_scalar, h0, map_zero]
  have : (1 : Cl77) = 0 := by
    calc (1 : Cl77) = ↑u⁻¹ * ↑u⁻¹ * (↑u * ↑u) := by
          rw [show (↑u⁻¹ : Cl77) * ↑u⁻¹ * (↑u * ↑u) = ↑u⁻¹ * (↑u⁻¹ * ↑u) * ↑u by
            simp only [mul_assoc], Units.inv_mul, mul_one, Units.inv_mul]
      _ = 0 := by rw [h2, mul_zero]
  exact one_ne_zero this

lemma inv_vec (u : Cl77ˣ) (m : Fin 14 → ℝ) (hu : (u : Cl77) = ι Q77 m) :
    (↑u⁻¹ : Cl77) = ι Q77 ((Q77 m)⁻¹ • m) := by
  rw [Units.inv_eq_of_mul_eq_one_right]
  rw [hu, map_smul, mul_smul_comm, ι_sq_scalar, Algebra.algebraMap_eq_smul_one, smul_smul,
    inv_mul_cancel₀ (Q_ne_of_unit u m hu), one_smul]

/-- Reflection formula: for `Q m ≠ 0`, `A (ι m)` sends `ι v` to `ι (v − (polar m v / Q m) m)`. -/
lemma Aμ_ι (u : Cl77ˣ) (m : Fin 14 → ℝ) (hu : (u : Cl77) = ι Q77 m) (v : Fin 14 → ℝ) :
    Aμ u (ι Q77 v) = ι Q77 (v - (QuadraticMap.polar Q77 m v / Q77 m) • m) := by
  have hQ : Q77 m ≠ 0 := Q_ne_of_unit u m hu
  have hinv := inv_vec u m hu
  rw [Aμ_apply, hinv, hu, involute_ι]
  have hanti := ι_mul_ι_add_swap (Q := Q77) m v
  rw [map_sub, map_smul, map_smul, neg_mul, mul_smul_comm]
  have e1 : ι Q77 m * ι Q77 v = algebraMap ℝ Cl77 (QuadraticMap.polar Q77 m v) - ι Q77 v * ι Q77 m := by
    rw [← hanti]; abel
  have e2 : -(ι Q77 m * ι Q77 v) * ι Q77 m =
      Q77 m • ι Q77 v - QuadraticMap.polar Q77 m v • ι Q77 m := by
    rw [e1, neg_sub, sub_mul, mul_assoc, ι_sq_scalar]
    simp only [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul, mul_smul_comm, mul_one]
  rw [e2, smul_sub, smul_smul, smul_smul, inv_mul_cancel₀ hQ, one_smul, div_eq_inv_mul]

/-- The reflection `v ↦ v − (polar m v / Q m) m`. -/
noncomputable def refl (m : Fin 14 → ℝ) : (Fin 14 → ℝ) →ₗ[ℝ] (Fin 14 → ℝ) :=
  LinearMap.id - LinearMap.smulRight ((Q77 m)⁻¹ • QuadraticMap.polarBilin Q77 m) m

lemma refl_apply (m v : Fin 14 → ℝ) :
    refl m v = v - (QuadraticMap.polar Q77 m v / Q77 m) • m := by
  simp [refl, div_eq_inv_mul]

lemma det_refl (m : Fin 14 → ℝ) (hQ : Q77 m ≠ 0) : LinearMap.det (refl m) = -1 := by
  set φ : Fin 14 → ℝ := fun j => QuadraticMap.polar Q77 m (Pi.single j 1) / Q77 m
  have hM : LinearMap.toMatrix' (refl m) = 1 + Matrix.replicateCol Unit (-m) * Matrix.replicateRow Unit φ := by
    ext i j
    simp only [LinearMap.toMatrix'_apply, refl_apply, Matrix.add_apply, Matrix.mul_apply,
      Matrix.replicateCol_apply, Matrix.replicateRow_apply, Finset.univ_unique, Finset.sum_singleton,
      Pi.sub_apply, Pi.smul_apply, smul_eq_mul, φ, Matrix.one_apply, Pi.single_apply, Pi.neg_apply]
    split_ifs <;> ring
  rw [← LinearMap.det_toMatrix', hM, Matrix.det_one_add_replicateCol_mul_replicateRow]
  have hsum : φ ⬝ᵥ m = QuadraticMap.polar Q77 m m / Q77 m := by
    have h := LinearMap.pi_apply_eq_sum_univ (QuadraticMap.polarBilin Q77 m) m
    simp only [QuadraticMap.polarBilin_apply_apply, smul_eq_mul] at h
    rw [h, Finset.sum_div]
    simp only [dotProduct, φ]
    refine Finset.sum_congr rfl fun j _ => ?_
    have e : (fun k => if j = k then (1 : ℝ) else 0) = Pi.single j 1 := by
      ext k; simp [Pi.single_apply, eq_comm]
    rw [e]; ring
  rw [dotProduct_neg, hsum, QuadraticMap.polar_self, nsmul_eq_mul]
  field_simp
  ring

lemma good_of_vec (u : Cl77ˣ) (m : Fin 14 → ℝ) (hu : (u : Cl77) = ι Q77 m) : Good u := by
  rintro a ⟨v, rfl⟩
  rw [Aμ_ι u m hu]; exact ⟨_, rfl⟩

lemma Tμ_vec (u : Cl77ˣ) (m : Fin 14 → ℝ) (hu : (u : Cl77) = ι Q77 m) (h : Good u) :
    LinearMap.det (Tμ u h) = -1 := by
  have e : Tμ u h = (ιEquiv : (Fin 14 → ℝ) ≃ₗ[ℝ] Vs).toLinearMap ∘ₗ refl m ∘ₗ ιEquiv.symm.toLinearMap := by
    ext a
    obtain ⟨v, hv⟩ := a.2
    have ha : a = ιEquiv v := Subtype.ext hv.symm
    subst ha
    simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply, LinearEquiv.symm_apply_apply]
    show Aμ u (ι Q77 v) = ι Q77 (refl m v)
    rw [Aμ_ι u m hu, refl_apply]
  rw [e, LinearMap.det_conj, det_refl m (Q_ne_of_unit u m hu)]

/-- The parity/determinant property, proved on the whole Lipschitz group. -/
def Par (u : Cl77ˣ) : Prop :=
  ∃ (hu : Good u), Good u⁻¹ ∧ ∃ s : ℝ, (s = 1 ∨ s = -1) ∧ involute (u : Cl77) = s • (u : Cl77) ∧
    LinearMap.det (Tμ u hu) = s

lemma good_one : Good 1 := fun a ha => by rw [Aμ_one]; exact ha

lemma good_mul {u v : Cl77ˣ} (hu : Good u) (hv : Good v) : Good (u * v) := fun a ha => by
  rw [Aμ_mul]; exact hu _ (hv a ha)

theorem par_lipschitz (u : Cl77ˣ) (hu : u ∈ lipschitzGroup Q77) : Par u := by
  induction hu using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨m, hm⟩ := hx
    have hm' : (x : Cl77) = ι Q77 m := hm.symm
    have hg := good_of_vec x m hm'
    refine ⟨hg, good_of_vec _ _ (inv_vec x m hm'), -1, Or.inr rfl, ?_, Tμ_vec x m hm' hg⟩
    rw [hm', involute_ι, neg_one_smul]
  | one =>
    have hg : Good 1 := good_one
    refine ⟨hg, by rw [inv_one]; exact hg, 1, Or.inl rfl, by simp, ?_⟩
    rw [Tμ_one, LinearMap.det_id]
  | mul x y _ _ hx hy =>
    obtain ⟨gx, gx', s, hs, ix, dx⟩ := hx
    obtain ⟨gy, gy', t, ht, iy, dy⟩ := hy
    have gxy := good_mul gx gy
    refine ⟨gxy, by rw [mul_inv_rev]; exact good_mul gy' gx', s * t, ?_, ?_, ?_⟩
    · rcases hs with rfl | rfl <;> rcases ht with rfl | rfl <;> norm_num
    · rw [Units.val_mul, map_mul, ix, iy, smul_mul_smul_comm]
    · rw [Tμ_mul x y gx gy gxy, LinearMap.det_comp, dx, dy]
  | inv x _ hx =>
    obtain ⟨gx, gx', s, hs, ix, dx⟩ := hx
    refine ⟨gx', by rw [inv_inv]; exact gx, s, hs, ?_, ?_⟩
    · have h1 : involute (↑x⁻¹ : Cl77) * involute (x : Cl77) = 1 := by
        rw [← map_mul, Units.inv_mul, map_one]
      rw [ix] at h1
      have hs2 : s * s = 1 := by rcases hs with rfl | rfl <;> norm_num
      calc involute (↑x⁻¹ : Cl77) = involute (↑x⁻¹ : Cl77) * (s • (x : Cl77)) * (s • ↑x⁻¹) := by
            rw [mul_assoc, smul_mul_smul_comm, hs2, one_smul, Units.mul_inv, mul_one]
        _ = s • (↑x⁻¹ : Cl77) := by rw [h1, one_mul]
    · have gid : Good (x⁻¹ * x) := by rw [inv_mul_cancel]; exact good_one
      have hid : Tμ (x⁻¹ * x) gid = LinearMap.id := by
        ext a; show Aμ (x⁻¹ * x) a = a; rw [inv_mul_cancel, Aμ_one]
      have h2 : LinearMap.det (Tμ (x⁻¹ * x) gid) = 1 := by rw [hid, LinearMap.det_id]
      rw [Tμ_mul x⁻¹ x gx' gx gid, LinearMap.det_comp, dx] at h2
      rcases hs with rfl | rfl
      · simpa using h2
      · linarith

/-- **`det (vecRep x) = 1`**: `Spin(7,7)` maps into `SO(7,7)`. -/
theorem det_vecRep (x : Spin77) :
    LinearMap.det ((vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : (Fin 14 → ℝ) →ₗ[ℝ] (Fin 14 → ℝ)) = 1 := by
  set u := spinUnit x
  have hu : u ∈ lipschitzGroup Q77 := pinGroup.units_mem_lipschitzGroup (spinGroup.mem_pin x.2)
  obtain ⟨g, -, s, hs, ix, dx⟩ := par_lipschitz u hu
  have hinv : (↑u⁻¹ : Cl77) = star (x : Cl77) := rfl
  have e : Tμ u g = (ιEquiv : (Fin 14 → ℝ) ≃ₗ[ℝ] Vs).toLinearMap ∘ₗ
      ((vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : (Fin 14 → ℝ) →ₗ[ℝ] (Fin 14 → ℝ)) ∘ₗ
        ιEquiv.symm.toLinearMap := by
    ext a
    obtain ⟨v, hv⟩ := a.2
    have ha : a = ιEquiv v := Subtype.ext hv.symm
    subst ha
    simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply, LinearEquiv.symm_apply_apply]
    show Aμ u (ι Q77 v) = ι Q77 (vecL x v)
    rw [Aμ_apply, hinv, ι_vecL, show (u : Cl77) = x from rfl, spinGroup.involute_eq x.2]
  have hs1 : s = 1 := by
    rcases hs with h | h
    · exact h
    · exfalso
      rw [h, show (u : Cl77) = x from rfl, spinGroup.involute_eq x.2, neg_one_smul] at ix
      have h0 : (x : Cl77) = 0 := by
        have : (2 : ℝ) • (x : Cl77) = 0 := by rw [two_smul]; nth_rewrite 1 [ix]; exact neg_add_cancel _
        exact (smul_eq_zero.mp this).resolve_left two_ne_zero
      have h1 := spinGroup.mul_star_self_of_mem x.2
      rw [h0, zero_mul] at h1
      exact zero_ne_one h1
  rw [← hs1, ← dx, e, LinearMap.det_conj]

end GU.Spinor
