import GU.Spinor.SpinImage

/-!
# `Spin6` and `Spin4` are double covers of the block special orthogonal groups

`Spin6` (generated by `ι a ι b`, `a, b` unit vectors in `W6 = span{e₁,…,e₆}`, `Q = +1`) and `Spin4`
(`W4 = span{e₁₀,…,e₁₃}`, `Q = −1`) were defined in `PatiSalamGroup.lean`. Here:

* **`block_onto`**: on a block `S` of uniform sign `q`, every isometry of `ℝ¹⁴` with `det = 1` that
  fixes every `e_j` with `j ∉ S` is `vecRep x` for some `x ∈ closure (gens S q)`. The proof re-runs the
  Cartan–Dieudonné step of `SpinImage.lean` inside `S`. All reflection vectors then have the same
  sign, so the spinor-norm obstruction (`g0_not_mem`) cannot occur, and even-length products pair up
  into generators.
* **`range_spin6` / `range_spin4`**: the image of `Spin6` (resp. `Spin4`) under `vecRep` is
  *exactly* the block `SO(6)` (resp. `SO(4)`): isometries with `det 1` that fix the complement.
* **`spin6_ker` / `spin4_ker`**: the kernel of the restricted map is `{1, −1}`.

* **`spin6_iff` / `spin4_iff`** (generator-free): `y ∈ Spin6` iff `vecRep y` is a block `SO(6)`
  element, i.e. `Spin6 = vecRep⁻¹(SO(6))`; likewise for `Spin4`.
* **`spin6_nonsplit` / `spin4_nonsplit`**: some `x` in the group has `x² = −1`, while `vecRep (x²) = 1`.

So `Spin6 → SO(6)` and `Spin4 → SO(4)` are **non-split double covers**: surjective, kernel `{±1}`
of two distinct elements (`negOne_ne_one`), and not isomorphic to `SO(n) × ℤ/2` as extensions (in a
split extension every lift of an involution can be chosen to square to `1`; here `x² = −1`). This is
the algebraic shape of `Spin(6)`, `Spin(4)`. Both are identified with Mathlib's `spinGroup` directly
(`spin4Equiv`, `SpinIso.lean`; `spin6Equiv`, `SpinIso6.lean`). `Spin4 ≃* Sp(1) × Sp(1)` is `spin4QuatEquiv`
(`SpinQuat.lean`). `Spin6 ≃* SU(4)` is `Spin6SU4` (`SU4Onto.lean`). Not proved:
topology or connectedness
(`Spin4 ≃* SU(2) × SU(2)` is `spin4SU2Equiv`, `SpinSU2.lean`).
-/

namespace GU.Spinor

open CliffordAlgebra

/-- The block `S` has uniform sign `q`. -/
def UniformSign (S : Finset (Fin 14)) (q : ℝ) : Prop := ∀ i ∈ S, Q77 (eb i) = q

lemma uniform_S6 : UniformSign S6 1 := fun i hi => by
  rw [Q_eb]; simp [(by decide : ∀ i ∈ S6, (i : ℕ) < 7) i hi]

lemma uniform_S4 : UniformSign S4 (-1) := fun i hi => by
  rw [Q_eb]; simp [(by decide : ∀ i ∈ S4, ¬ (i : ℕ) < 7) i hi]

variable {S : Finset (Fin 14)} {q : ℝ}

lemma Q_block (hS : UniformSign S q) {m : Fin 14 → ℝ} (hm : SuppIn S m) :
    Q77 m = q * ∑ i, m i ^ 2 := by
  simp only [Q77, QuadraticMap.weightedSumSquares_apply, smul_eq_mul]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  by_cases hi : i ∈ S
  · have h := hS i hi
    rw [Q_eb] at h
    rw [h]; ring
  · rw [hm i hi]; ring

lemma polar_eb_right (v : Fin 14 → ℝ) (j : Fin 14) :
    QuadraticMap.polar Q77 v (eb j) = 2 * ((if (j : ℕ) < 7 then (1 : ℝ) else -1) * v j) := by
  rw [polar_Q77, Finset.sum_eq_single j]
  · simp [eb]
  · intro i _ hij; simp [eb, hij]
  · simp

lemma supp_of_polar (v : Fin 14 → ℝ) (h : ∀ j ∉ S, QuadraticMap.polar Q77 v (eb j) = 0) :
    SuppIn S v := fun j hj => by
  have := h j hj
  rw [polar_eb_right] at this
  split_ifs at this <;> linarith

lemma polar_supp_eb {m : Fin 14 → ℝ} (hm : SuppIn S m) {j : Fin 14} (hj : j ∉ S) :
    QuadraticMap.polar Q77 m (eb j) = 0 := by
  rw [polar_eb_right, hm j hj]; ring

/-- Unit vectors in the block `S` with `Q = q`. -/
abbrev BVec (S : Finset (Fin 14)) (q : ℝ) := {m : UVec // SuppIn S m.1 ∧ Q77 m.1 = q}

/-- Normalise an anisotropic block vector. -/
lemma exists_BVec (hS : UniformSign S q) {m : Fin 14 → ℝ} (hm : SuppIn S m) (hQ : Q77 m ≠ 0) :
    ∃ u : BVec S q, refl u.1.1 = refl m := by
  set c : ℝ := (Real.sqrt |Q77 m|)⁻¹
  have hpos : 0 < |Q77 m| := abs_pos.mpr hQ
  have hc : c ≠ 0 := inv_ne_zero (Real.sqrt_ne_zero'.mpr hpos)
  have hcc : c * c = (|Q77 m|)⁻¹ := by rw [← mul_inv, Real.mul_self_sqrt hpos.le]
  have hQc : Q77 (c • m) = Q77 m / |Q77 m| := by
    rw [QuadraticMap.map_smul, smul_eq_mul, hcc, inv_mul_eq_div]
  have hunit : Q77 (c • m) = 1 ∨ Q77 (c • m) = -1 := by
    rw [hQc]
    rcases lt_or_gt_of_ne hQ with h | h
    · right; rw [abs_of_neg h, div_neg, div_self hQ]
    · left; rw [abs_of_pos h, div_self hQ]
  have hsupp : SuppIn S (c • m) := fun j hj => by simp [hm j hj]
  have hblock := Q_block hS hsupp
  have hsq : 0 ≤ ∑ i, (c • m) i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hq : Q77 (c • m) = q := by
    -- `Q (c m) = q · (nonneg)` and both `Q (c m)`, `q` are `±1`
    have hm0 : m ≠ 0 := fun h => hQ (by rw [h, QuadraticMap.map_zero])
    obtain ⟨i, hi⟩ : ∃ i, m i ≠ 0 := by
      by_contra h; push Not at h; exact hm0 (funext h)
    have hiS : i ∈ S := by by_contra h; exact hi (hm i h)
    have hqi := hS i hiS
    rw [Q_eb] at hqi
    have hq1 : q = 1 ∨ q = -1 := by split_ifs at hqi <;> [left; right] <;> exact hqi.symm
    rcases hunit with h1 | h1 <;> rcases hq1 with rfl | rfl
    · exact h1
    · exfalso; rw [h1] at hblock; linarith
    · exfalso; rw [h1] at hblock; linarith
    · exact h1
  exact ⟨⟨⟨c • m, hunit⟩, hsupp, hq⟩, refl_smul hc⟩

/-- `r_{v₁} ⋯ r_{vₘ}` for block vectors. -/
noncomputable def reflB (l : List (BVec S q)) : Module.End ℝ (Fin 14 → ℝ) :=
  reflProd (l.map Subtype.val)

lemma reflB_cons (m : BVec S q) (l : List (BVec S q)) : reflB (m :: l) = refl m.1.1 * reflB l := rfl

lemma reflB_append (l l' : List (BVec S q)) : reflB (l ++ l') = reflB l * reflB l' := by
  rw [reflB, List.map_append, reflProd_append]; rfl

/-- One block step: fix `e_k` (`k ∈ S`) without disturbing `e_j` for `j < k` or `j ∉ S`. -/
lemma stepB (hS : UniformSign S q) (f : Module.End ℝ (Fin 14 → ℝ)) (hf : IsIsom77 f) (k : Fin 14)
    (hk : k ∈ S) (hfix : ∀ j : Fin 14, (j < k ∨ j ∉ S) → f (eb j) = eb j) :
    ∃ l : List (BVec S q), ∀ j : Fin 14, (j ≤ k ∨ j ∉ S) → (reflB l * f) (eb j) = eb j := by
  set x := eb k
  set y := f x
  have hQ : Q77 y = Q77 x := hf x
  have hx : Q77 x ≠ 0 := Q_eb_ne k
  have hne : ∀ j : Fin 14, (j < k ∨ j ∉ S) → j ≠ k := by
    rintro j (hj | hj) rfl
    · exact lt_irrefl _ hj
    · exact hj hk
  have hyo : ∀ j : Fin 14, (j < k ∨ j ∉ S) → QuadraticMap.polar Q77 y (eb j) = 0 := fun j hj => by
    rw [← hfix j hj, hf.polar, polar_eb (hne j hj).symm]
  have hxo : ∀ j : Fin 14, (j < k ∨ j ∉ S) → QuadraticMap.polar Q77 x (eb j) = 0 :=
    fun j hj => polar_eb (hne j hj).symm
  have hxs : SuppIn S x := fun j hj => by simp [x, eb, (hne j (Or.inr hj))]
  have hys : SuppIn S y := supp_of_polar y fun j hj => hyo j (Or.inr hj)
  have hds : SuppIn S (y - x) := fun j hj => by simp [hys j hj, hxs j hj]
  have hss : SuppIn S (y + x) := fun j hj => by simp [hys j hj, hxs j hj]
  by_cases hd : Q77 (y - x) ≠ 0
  · obtain ⟨u, hu⟩ := exists_BVec hS hds hd
    refine ⟨[u], fun j hj => ?_⟩
    simp only [reflB, List.map_cons, List.map_nil, reflProd_cons, reflProd_nil, mul_one,
      Module.End.mul_apply, hu]
    rcases hj with hj | hj
    · rcases lt_or_eq_of_le hj with hj | rfl
      · rw [hfix j (Or.inl hj)]
        exact refl_fix (m := y - x) (v := eb j)
          (by rw [QuadraticMap.polar_sub_left, hyo j (Or.inl hj), hxo j (Or.inl hj), sub_zero])
      · show refl (y - x) y = x
        rw [refl_apply, polar_sub_self hQ, div_self hd, one_smul, sub_sub_cancel]
    · rw [hfix j (Or.inr hj)]
      exact refl_fix (polar_supp_eb hds hj)
  · push Not at hd
    have hs : Q77 (y + x) ≠ 0 := by
      have e1 : Q77 (y + x) = Q77 y + Q77 x + QuadraticMap.polar Q77 y x :=
        QuadraticMap.map_add Q77 _ _
      have e2 : Q77 (y - x) = Q77 y + Q77 x - QuadraticMap.polar Q77 y x := by
        rw [sub_eq_add_neg, QuadraticMap.map_add Q77, QuadraticMap.map_neg,
          QuadraticMap.polar_neg_right]
        ring
      intro h0; apply hx; linarith
    obtain ⟨u, hu⟩ := exists_BVec hS hss hs
    obtain ⟨w, hw⟩ := exists_BVec hS hxs hx
    refine ⟨[w, u], fun j hj => ?_⟩
    simp only [reflB, List.map_cons, List.map_nil, reflProd_cons, reflProd_nil, mul_one,
      Module.End.mul_apply, hu, hw]
    rcases hj with hj | hj
    · rcases lt_or_eq_of_le hj with hj | rfl
      · rw [hfix j (Or.inl hj), refl_fix (m := y + x) (v := eb j)
          (by rw [QuadraticMap.polar_add_left, hyo j (Or.inl hj), hxo j (Or.inl hj), add_zero]),
          refl_fix (m := x) (v := eb j) (hxo j (Or.inl hj))]
      · show refl x (refl (y + x) y) = x
        rw [refl_apply (y + x), polar_add_self hQ, div_self hs, one_smul,
          show y - (y + x) = -x by abel, map_neg, refl_self hx, neg_neg]
    · rw [hfix j (Or.inr hj), refl_fix (polar_supp_eb hss hj), refl_fix (polar_supp_eb hxs hj)]

lemma fix_uptoB (hS : UniformSign S q) (f : Module.End ℝ (Fin 14 → ℝ)) (hf : IsIsom77 f)
    (hout : ∀ j ∉ S, f (eb j) = eb j) :
    ∀ n ≤ 14, ∃ l : List (BVec S q), ∀ j : Fin 14, ((j : ℕ) < n ∨ j ∉ S) →
      (reflB l * f) (eb j) = eb j := by
  intro n
  induction n with
  | zero =>
    intro _
    refine ⟨[], fun j hj => ?_⟩
    rcases hj with hj | hj
    · exact absurd hj (Nat.not_lt_zero _)
    · show (1 * f) (eb j) = eb j
      rw [one_mul]; exact hout j hj
  | succ n ih =>
    intro hn
    obtain ⟨l, hl⟩ := ih (by omega)
    set k : Fin 14 := ⟨n, by omega⟩
    by_cases hk : k ∈ S
    · obtain ⟨l', hl'⟩ := stepB hS (reflB l * f) ((isIsom_reflProd _).mul hf) k hk
        (fun j hj => hl j (by
          rcases hj with hj | hj
          · left; exact hj
          · right; exact hj))
      refine ⟨l' ++ l, fun j hj => ?_⟩
      rw [reflB_append, mul_assoc]
      refine hl' j ?_
      rcases hj with hj | hj
      · left; rw [Fin.le_def]; show (j : ℕ) ≤ n; omega
      · right; exact hj
    · refine ⟨l, fun j hj => hl j ?_⟩
      rcases hj with hj | hj
      · by_cases hjn : (j : ℕ) = n
        · right
          have : j = k := Fin.ext hjn
          rw [this]; exact hk
        · left; omega
      · right; exact hj

/-- Block Cartan–Dieudonné: block isometries are products of block reflections. -/
theorem isom_eq_reflB (hS : UniformSign S q) (g : Module.End ℝ (Fin 14 → ℝ)) (hg : IsIsom77 g)
    (hout : ∀ j ∉ S, g (eb j) = eb j) : ∃ l : List (BVec S q), g = reflB l := by
  obtain ⟨l, hl⟩ := fix_uptoB hS g hg hout 14 le_rfl
  have hid : reflB l * g = 1 :=
    (Pi.basisFun ℝ (Fin 14)).ext fun j => by
      simpa [Pi.basisFun_apply] using hl j (Or.inl j.2)
  refine ⟨l.reverse, ?_⟩
  have hrev : reflB l.reverse * reflB l = 1 := by
    rw [reflB, reflB, List.map_reverse]; exact reflProd_reverse_mul _
  calc g = (reflB l.reverse * reflB l) * g := by rw [hrev, one_mul]
    _ = reflB l.reverse := by rw [mul_assoc, hid, mul_one]

/-- A pair of block vectors gives a generator of `closure (gens S q)`. -/
noncomputable def pairElt (a b : BVec S q) : Spin77 :=
  ⟨ι Q77 a.1.1 * ι Q77 b.1.1, pair_mem _ _ (by rw [a.2.2, b.2.2]; rcases a.1.2 with h | h <;>
    rw [a.2.2] at h <;> rw [h] <;> norm_num)⟩

lemma vecRep_pairElt (a b : BVec S q) :
    ((vecRep (pairElt a b) : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) =
      refl a.1.1 * refl b.1.1 := by
  refine LinearMap.ext fun w => ι_injective ?_
  show ι Q77 (vecL _ w) = _
  rw [ι_vecL]
  have hY : ((pairElt a b : Spin77) : Cl77) = yProd [a.1, b.1] := by
    simp [pairElt, yProd]
  have hq : qProd [a.1, b.1] = 1 := by
    simp only [qProd_cons, qProd_nil, mul_one, a.2.2, b.2.2]
    rcases a.1.2 with h | h <;> rw [a.2.2] at h <;> rw [h] <;> norm_num
  rw [hY, yProd_conj, hq, one_smul]
  rfl

lemma lift_even : ∀ n : ℕ, ∀ l : List (BVec S q), l.length = 2 * n →
    ∃ x ∈ Subgroup.closure (gens S q),
      ((vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = reflB l := by
  intro n
  induction n with
  | zero =>
    intro l hl
    have hl0 : l = [] := List.length_eq_zero_iff.mp (by simpa using hl)
    subst hl0
    exact ⟨1, Subgroup.one_mem _, by rw [map_one]; rfl⟩
  | succ n ih =>
    intro l hl
    match l, hl with
    | a :: b :: rest, hl =>
      obtain ⟨x, hx, hxr⟩ := ih rest (by simp at hl; omega)
      refine ⟨pairElt a b * x, Subgroup.mul_mem _ (Subgroup.subset_closure
        ⟨a.1.1, b.1.1, a.2.1, b.2.1, a.2.2, b.2.2, rfl⟩) hx, ?_⟩
      rw [map_mul, LinearEquiv.coe_toLinearMap_mul, vecRep_pairElt, hxr, reflB_cons, reflB_cons,
        mul_assoc]

/-- **Block surjectivity**: every block `SO` element lifts to `closure (gens S q)`. -/
theorem block_onto (hS : UniformSign S q) (g : Module.End ℝ (Fin 14 → ℝ)) (hg : IsIsom77 g)
    (hdet : LinearMap.det g = 1) (hout : ∀ j ∉ S, g (eb j) = eb j) :
    ∃ x ∈ Subgroup.closure (gens S q),
      ((vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = g := by
  obtain ⟨l, rfl⟩ := isom_eq_reflB hS g hg hout
  have he : Even l.length := by
    rw [reflB, det_reflProd, List.length_map] at hdet
    exact neg_one_pow_even hdet
  obtain ⟨n, hn⟩ := he
  exact lift_even n l (by omega)

/-- Elements of `closure (gens S q)` act as block `SO` elements. -/
lemma closure_block (x : Spin77) (hx : x ∈ Subgroup.closure (gens S q)) :
    IsIsom77 (vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) ∧
      LinearMap.det ((vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = 1 ∧
      ∀ j ∉ S, vecRep x (eb j) = eb j := by
  refine ⟨vecRep_isometry x, det_vecRep x, fun j hj => ?_⟩
  have hle : Subgroup.closure (gens S q) ≤ fixSub (perpOf S) :=
    (Subgroup.closure_le _).mpr fun y hy => gens_fix hy
  refine hle hx (eb j) (off_perp fun i hi => ?_)
  have : i ≠ j := fun h => hj (h ▸ hi)
  simp [eb, this]

/-- **The image of `Spin6` is exactly the block `SO(6)`** on `W6 = span{e₁,…,e₆}`. -/
theorem range_spin6 (g : Module.End ℝ (Fin 14 → ℝ)) :
    (∃ x ∈ Spin6, ((vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = g) ↔
      IsIsom77 g ∧ LinearMap.det g = 1 ∧ ∀ j ∉ S6, g (eb j) = eb j := by
  constructor
  · rintro ⟨x, hx, rfl⟩; exact closure_block x hx
  · rintro ⟨hg, hdet, hout⟩; exact block_onto uniform_S6 g hg hdet hout

/-- **The image of `Spin4` is exactly the block `SO(4)`** on `W4 = span{e₁₀,…,e₁₃}`. -/
theorem range_spin4 (g : Module.End ℝ (Fin 14 → ℝ)) :
    (∃ x ∈ Spin4, ((vecRep x : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = g) ↔
      IsIsom77 g ∧ LinearMap.det g = 1 ∧ ∀ j ∉ S4, g (eb j) = eb j := by
  constructor
  · rintro ⟨x, hx, rfl⟩; exact closure_block x hx
  · rintro ⟨hg, hdet, hout⟩; exact block_onto uniform_S4 g hg hdet hout

lemma negOne_mem_of (H : Subgroup Spin77) (h : ∃ x ∈ H, (x : Cl77) = -1) : negOne ∈ H := by
  obtain ⟨x, hx, e⟩ := h
  have : x = negOne := Subtype.ext e
  exact this ▸ hx

/-- **Kernel of `Spin6 → SO(6)` is `{±1}`** (two distinct elements: `negOne_ne_one`). -/
theorem spin6_ker (x : Spin77) : (x ∈ Spin6 ∧ x ∈ vecRep.ker) ↔ x = 1 ∨ x = negOne := by
  rw [mem_ker_iff]
  constructor
  · exact fun h => h.2
  · rintro (rfl | rfl)
    · exact ⟨Subgroup.one_mem _, Or.inl rfl⟩
    · exact ⟨negOne_mem_of _ neg_one_mem_Spin6, Or.inr rfl⟩

/-- **Kernel of `Spin4 → SO(4)` is `{±1}`** (two distinct elements: `negOne_ne_one`). -/
theorem spin4_ker (x : Spin77) : (x ∈ Spin4 ∧ x ∈ vecRep.ker) ↔ x = 1 ∨ x = negOne := by
  rw [mem_ker_iff]
  constructor
  · exact fun h => h.2
  · rintro (rfl | rfl)
    · exact ⟨Subgroup.one_mem _, Or.inl rfl⟩
    · exact ⟨negOne_mem_of _ neg_one_mem_Spin4, Or.inr rfl⟩

/-- Generator-free characterisation of a block group: the full preimage of block `SO`. -/
lemma block_iff (hS : UniformSign S q) (H : Subgroup Spin77) (hH : H = Subgroup.closure (gens S q))
    (hneg : negOne ∈ H) (y : Spin77) :
    y ∈ H ↔ (IsIsom77 (vecRep y : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) ∧
      LinearMap.det ((vecRep y : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = 1 ∧
      ∀ j ∉ S, vecRep y (eb j) = eb j) := by
  subst hH
  constructor
  · exact closure_block y
  · rintro ⟨hg, hdet, hout⟩
    obtain ⟨x, hx, hxy⟩ := block_onto hS _ hg hdet hout
    have he : vecRep x = vecRep y := LinearEquiv.toLinearMap_injective hxy
    rcases (vecRep_eq_iff y x).mp he.symm with e | e
    · rw [Subtype.ext e]; exact hx
    · have : y = negOne * x := Subtype.ext (by rw [Submonoid.coe_mul, e]; simp [negOne])
      rw [this]; exact Subgroup.mul_mem _ hneg hx

/-- **`Spin6 = vecRep⁻¹(SO(6))`**. -/
theorem spin6_iff (y : Spin77) :
    y ∈ Spin6 ↔ (IsIsom77 (vecRep y : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) ∧
      LinearMap.det ((vecRep y : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = 1 ∧
      ∀ j ∉ S6, vecRep y (eb j) = eb j) :=
  block_iff uniform_S6 Spin6 rfl (negOne_mem_of _ neg_one_mem_Spin6) y

/-- **`Spin4 = vecRep⁻¹(SO(4))`**. -/
theorem spin4_iff (y : Spin77) :
    y ∈ Spin4 ↔ (IsIsom77 (vecRep y : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) ∧
      LinearMap.det ((vecRep y : (Fin 14 → ℝ) ≃ₗ[ℝ] (Fin 14 → ℝ)) : Module.End ℝ (Fin 14 → ℝ)) = 1 ∧
      ∀ j ∉ S4, vecRep y (eb j) = eb j) :=
  block_iff uniform_S4 Spin4 rfl (negOne_mem_of _ neg_one_mem_Spin4) y

/-- Non-splitness: two orthogonal block basis vectors give `x` with `x² = −1`. -/
lemma block_nonsplit (hS : UniformSign S q) {i j : Fin 14} (hi : i ∈ S) (hj : j ∈ S) (hij : i ≠ j) :
    ∃ x ∈ Subgroup.closure (gens S q), x * x = negOne := by
  have hsupp : ∀ k ∈ S, SuppIn S (eb k) := fun k hk l hl => by
    have : l ≠ k := fun h => hl (h ▸ hk)
    simp [eb, this]
  have hu : ∀ k ∈ S, Q77 (eb k) = 1 ∨ Q77 (eb k) = -1 := fun k _ => by
    rw [Q_eb]; split_ifs <;> simp
  let a : BVec S q := ⟨⟨eb i, hu i hi⟩, hsupp i hi, hS i hi⟩
  let b : BVec S q := ⟨⟨eb j, hu j hj⟩, hsupp j hj, hS j hj⟩
  have hqq : q * q = 1 := by rw [← hS i hi]; exact (show UVec from ⟨eb i, hu i hi⟩).Q_sq
  refine ⟨pairElt a b, Subgroup.subset_closure
      ⟨eb i, eb j, hsupp i hi, hsupp j hj, hS i hi, hS j hj, rfl⟩, ?_⟩
  apply Subtype.ext
  show ι Q77 (eb i) * ι Q77 (eb j) * (ι Q77 (eb i) * ι Q77 (eb j)) = -1
  rw [pair_sq (polar_eb hij.symm), hS i hi, hS j hj, hqq, map_neg, map_one]

/-- **`Spin6 → SO(6)` does not split**: `x = e₁e₂` has `x² = −1`. -/
theorem spin6_nonsplit : ∃ x ∈ Spin6, x * x = negOne :=
  block_nonsplit uniform_S6 (i := 1) (j := 2) (by decide) (by decide) (by decide)

/-- **`Spin4 → SO(4)` does not split**: `x = e₁₀e₁₁` has `x² = −1`. -/
theorem spin4_nonsplit : ∃ x ∈ Spin4, x * x = negOne :=
  block_nonsplit uniform_S4 (i := 10) (j := 11) (by decide) (by decide) (by decide)

end GU.Spinor
