lemma kpT_mem : ∀ m, kpT m ∈ knPairs := by decide +kernel

set_option maxRecDepth 100000 in
/-- Non-vacuity: the KN tensors are algebraic curvature tensors. -/
theorem isCurv_knT : ∀ p ∈ knPairs, (∀ a b c d, knT p a b c d = -knT p b a c d) ∧
    (∀ a b c d, knT p a b c d = -knT p a b d c) ∧
    (∀ a b c d, knT p a b c d + knT p a c d b + knT p a d b c = 0) := by decide +kernel

set_option maxHeartbeats 8000000 in
/-- **Coordinates**: an algebraic curvature tensor is determined by its 20 pivot components. -/
theorem curv_coords (R : Tens) (hR : IsCurv R) (a b c d : Fin 4) :
    R a b c d = ∑ m : Fin 20, R (pivT m).1 (pivT m).2.1 (pivT m).2.2.1 (pivT m).2.2.2 * Etab m a b c d := by
  have h1 := hR.h1; have h2 := hR.h2; have h3 := hR.h3
  have q : ∀ x : Fin 4, x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3 := by decide
  rcases q a with rfl | rfl | rfl | rfl <;> rcases q b with rfl | rfl | rfl | rfl <;>
    rcases q c with rfl | rfl | rfl | rfl <;> rcases q d with rfl | rfl | rfl | rfl
  · (simp [Fin.sum_univ_succ, pivT, Etab]) <;> linarith [h1 0 0 0 0]
  · (simp [Fin.sum_univ_succ, pivT, Etab]) <;> linarith [h1 0 0 0 1]
  · (simp [Fin.sum_univ_succ, pivT, Etab]) <;> linarith [h1 0 0 0 2]
  · (simp [Fin.sum_univ_succ, pivT, Etab]) <;> linarith [h1 0 0 0 3]
