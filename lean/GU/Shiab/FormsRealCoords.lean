set_option maxRecDepth 100000 in
lemma isCurv_Etab : ∀ m, IsCurv (Etab m) := by
  intro m
  have h : (∀ a b c d, Etab m a b c d = -Etab m b a c d) ∧ (∀ a b c d, Etab m a b c d = -Etab m a b d c) ∧
      (∀ a b c d, Etab m a b c d + Etab m a c d b + Etab m a d b c = 0) := by
    revert m; decide +kernel
  exact ⟨h.1, h.2.1, h.2.2⟩

/-- **Einstein output for every real algebraic curvature tensor** (n = 4, Euclidean, printed (9.3)
with Hodge stars, doubled): `twoShiabS (curvR R) = einR R`. -/
theorem einstein_all_real (R : TensR) (hR : IsCurvR R) : twoShiabS (curvR R) = einR R := by
  set E : Fin 20 → TensR := fun m a b c d => (Etab m a b c d : ℝ)
  have hR' : R = ∑ m : Fin 20, R (pivT m).1 (pivT m).2.1 (pivT m).2.2.1 (pivT m).2.2.2 • E m := by
    funext a b c d
    rw [curv_coordsR R hR a b c d]
    simp [E, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  have hb : ∀ m, twoShiabL (curvRL (E m)) = einRL (E m) := fun m => by
    show twoShiabS (curvR (E m)) = einR (E m)
    rw [show curvR (E m) = semF (curvForm (Etab m)) from curvR_cast _,
      show einR (E m) = semF (einsteinForm (Etab m)) from einR_cast _]
    funext I
    rw [← semF_twoShiab (canon_curvForm _)]
    exact einstein_all_curv _ (isCurv_Etab m) I
  show twoShiabL (curvRL R) = einRL R
  rw [hR', map_sum, map_sum, map_sum]
  exact Finset.sum_congr rfl fun m _ => by rw [map_smul, map_smul, map_smul, hb]

/-- Non-vacuity: integer algebraic curvature tensors are real ones. -/
lemma isCurvR_cast {R : Tens} (hR : IsCurv R) : IsCurvR (fun a b c d => (R a b c d : ℝ)) :=
  ⟨fun a b c d => by simp [hR.h1 a b c d], fun a b c d => by simp [hR.h2 a b c d],
   fun a b c d => by exact_mod_cast hR.h3 a b c d⟩

