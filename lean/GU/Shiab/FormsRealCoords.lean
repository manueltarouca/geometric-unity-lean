import GU.Shiab.FormsReal

/-!
# Track 2 (real version), part 2: every real algebraic curvature tensor

`curv_coordsR`: a real algebraic curvature tensor is `Σ_m R(p_m) · E_m`. The 256 identities are proved
by `linear_combination` with exact rational certificates, generated by `scripts/f2/emitR.py` from
`gen.py`. **`einstein_all_real`**: for every *real* algebraic curvature tensor `R` (n = 4, Euclidean),
the semantic doubled printed Shiab of its curvature form equals `−4 ⋆(Einstein form)`, i.e.
`twoShiabS (curvR R) = einR R`. This lifts `einstein_all_curv` from integer to real coefficients (and supersedes the "real-linear
version is open" note in `FormsCurvSpan.lean`). Reproduce from `lean/` with `python3 -I
scripts/f2/kn.py && python3 -I scripts/f2/gen.py && python3 -I scripts/f2/emitR.py`.
-/

namespace GU.FormsW

open GU.Spinor

/-- Real algebraic curvature tensors. -/
structure IsCurvR (R : TensR) : Prop where
  h1 : ∀ a b c d, R a b c d = -R b a c d
  h2 : ∀ a b c d, R a b c d = -R a b d c
  h3 : ∀ a b c d, R a b c d + R a c d b + R a d b c = 0

set_option maxHeartbeats 8000000 in
theorem curv_coordsR (R : TensR) (hR : IsCurvR R) (a b c d : Fin 4) :
    R a b c d = ∑ m : Fin 20, R (pivT m).1 (pivT m).2.1 (pivT m).2.2.1 (pivT m).2.2.2 * (Etab m a b c d : ℝ) := by
  have h1 := hR.h1; have h2 := hR.h2; have h3 := hR.h3
  have q : ∀ x : Fin 4, x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3 := by decide
  rcases q a with rfl | rfl | rfl | rfl <;> rcases q b with rfl | rfl | rfl | rfl <;>
    rcases q c with rfl | rfl | rfl | rfl <;> rcases q d with rfl | rfl | rfl | rfl
  · (simp [Fin.sum_univ_succ, pivT, Etab]) <;> linear_combination (1/2) * h1 0 0 0 0
  · (simp [Fin.sum_univ_succ, pivT, Etab]) <;> linear_combination (1/2) * h1 0 0 0 1
  · (simp [Fin.sum_univ_succ, pivT, Etab]) <;> linear_combination (1/2) * h1 0 0 0 2
